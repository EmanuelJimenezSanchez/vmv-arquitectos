---
import { estados } from '@/data/alcance'
---

<link rel="stylesheet" href="https://unpkg.com/maplibre-gl@5/dist/maplibre-gl.css" />
<script
  is:inline
  src="https://unpkg.com/maplibre-gl@5/dist/maplibre-gl.js"
  data-alcance-cdn></script>

<section
  id="alcance"
  class="relative bg-vmv-background py-[clamp(4rem,9vw,7.5rem)]"
  data-alcance
  aria-labelledby="alcance-title"
>
  <div
    class="mx-auto flex w-full max-w-[110rem] flex-col gap-[clamp(2.5rem,5vw,4rem)] px-[clamp(1.25rem,5vw,3rem)] lg:flex-row lg:items-center lg:gap-[clamp(2rem,4vw,4.5rem)]"
  >
    <div
      class="relative h-[clamp(20rem,58vw,32rem)] w-full overflow-hidden rounded-sm border border-vmv-border bg-vmv-muted lg:h-[min(74vh,42rem)] lg:flex-1"
    >
      <div class="h-full w-full" data-alcance-map></div>
      <div
        class="pointer-events-none absolute inset-0 rounded-sm ring-1 ring-vmv-foreground/8 ring-inset"
        aria-hidden="true"
      >
      </div>
    </div>

    <div
      class="flex flex-col gap-[clamp(1.5rem,3vw,2.25rem)] lg:w-[clamp(20rem,36vw,34rem)] lg:shrink-0"
    >
      <header class="flex flex-col gap-4 lg:items-end lg:text-right">
        <p class="vmv-overline-1 flex items-center gap-3 text-vmv-sand-9 lg:flex-row-reverse">
          <span class="h-px w-9 bg-vmv-sand-9/60" aria-hidden="true"></span>
          Dónde construimos
        </p>
        <h2 id="alcance-title" class="vmv-title-1 text-vmv-foreground">Alcance</h2>
        <p class="vmv-body-2 max-w-[42ch] text-vmv-muted-foreground">
          Ejecutamos obra y supervisión en toda la República. Pasa el cursor sobre un estado para
          ubicarlo en el mapa.
        </p>
      </header>

      <ul
        class="grid grid-cols-2 gap-x-[clamp(1rem,2vw,2rem)] gap-y-1 justify-items-start lg:justify-items-end"
      >
        {
          estados.map((estado) => (
            <li>
              <button
                type="button"
                class="group/item vmv-title-3 flex cursor-pointer items-center gap-2 text-vmv-muted-foreground/60 transition-colors duration-500 ease-vmv focus-visible:outline-2 focus-visible:outline-offset-6 focus-visible:outline-vmv-ring data-[active=true]:text-vmv-foreground lg:flex-row-reverse"
                data-alcance-item
                data-id={estado.id}
              >
                <span
                  class="h-px w-0 bg-vmv-foreground/45 transition-[width] duration-500 ease-vmv group-data-[active=true]/item:w-6"
                  aria-hidden="true"
                />
                {estado.name}
              </button>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script>
  import type { LngLatBounds, Map as MapLibreMap } from 'maplibre-gl'
  import { $, $$ } from '@/lib/dom-selector'
  import { mapColors, mapFit, mapStyles } from '@/data/alcance'
  import estadosGeoJson from '@/data/alcance-estados.json'

  const SOURCE_ID = 'alcance-estados'
  const FILL_LAYER = 'alcance-estados-fill'
  const LINE_LAYER = 'alcance-estados-line'

  let cleanupAlcance: (() => void) | null = null
  let activeSection: HTMLElement | null = null

  // Polygon y MultiPolygon anidan las posiciones a distinta profundidad.
  const extendBounds = (bounds: LngLatBounds, coordinates: unknown): void => {
    if (!Array.isArray(coordinates)) {
      return
    }

    if (typeof coordinates[0] === 'number') {
      bounds.extend(coordinates as [number, number])
      return
    }

    coordinates.forEach((child) => extendBounds(bounds, child))
  }

  const setupAlcance = () => {
    const section = $<HTMLElement>('[data-alcance]')

    // Reinicializar la misma sección tiraría el mapa ya montado sin ganar nada.
    if (section && section === activeSection) {
      return
    }

    cleanupAlcance?.()
    cleanupAlcance = null
    activeSection = section

    if (!section) {
      return
    }

    const mapContainer = $<HTMLElement>('[data-alcance-map]', section)

    if (!mapContainer) {
      return
    }

    const controller = new AbortController()
    const { signal } = controller

    let map: MapLibreMap | null = null
    let activeId: string | null = null

    const getTheme = () => (document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light')
    let currentTheme = getTheme()

    // El id enlaza cada texto de la lista con el polígono de su estado en el GeoJSON.
    const whenActive = <T,>(active: T, idle: T): T =>
      ['case', ['==', ['get', 'id'], activeId ?? ''], active, idle] as unknown as T

    const paintEstados = () => {
      if (!map?.getLayer(FILL_LAYER)) {
        return
      }

      const { fill, active } = mapColors[currentTheme]

      map.setPaintProperty(FILL_LAYER, 'fill-color', whenActive(active, fill))
      map.setPaintProperty(FILL_LAYER, 'fill-opacity', whenActive(0.3, 0.08))
      map.setPaintProperty(LINE_LAYER, 'line-color', whenActive(active, fill))
      map.setPaintProperty(LINE_LAYER, 'line-opacity', whenActive(0.85, 0.3))
      map.setPaintProperty(LINE_LAYER, 'line-width', whenActive(1.4, 0.8))
    }

    const targets = $$<HTMLElement>('[data-alcance-item]', section)

    const setActive = (id: string | null) => {
      activeId = id
      targets.forEach((element) => {
        element.dataset.active = String(element.dataset.id === id)
      })
      paintEstados()
    }

    targets.forEach((element) => {
      const id = element.dataset.id ?? null
      element.addEventListener('pointerenter', () => setActive(id), { signal })
      element.addEventListener('pointerleave', () => setActive(null), { signal })
      element.addEventListener('focus', () => setActive(id), { signal })
      element.addEventListener('blur', () => setActive(null), { signal })
      element.addEventListener('click', () => setActive(id), { signal })
    })

    // Las capas symbol son todas las etiquetas del estilo base (países, estados, ciudades,
    // calles): se descartan al cargar el estilo para que solo se lean nuestros estados.
    // transformStyle también reinyecta el GeoJSON, que setStyle borraría al cambiar de tema.
    const applyStyle = (instance: MapLibreMap, theme: 'light' | 'dark') => {
      const { fill, active } = mapColors[theme]

      instance.setStyle(mapStyles[theme], {
        transformStyle: (_previous, next) => ({
          ...next,
          sources: {
            ...next.sources,
            [SOURCE_ID]: { type: 'geojson', data: estadosGeoJson as never },
          },
          layers: [
            ...next.layers.filter((layer) => layer.type !== 'symbol'),
            {
              id: FILL_LAYER,
              type: 'fill',
              source: SOURCE_ID,
              paint: {
                'fill-color': whenActive(active, fill),
                'fill-opacity': whenActive(0.3, 0.08),
              },
            },
            {
              id: LINE_LAYER,
              type: 'line',
              source: SOURCE_ID,
              paint: {
                'line-color': whenActive(active, fill),
                'line-opacity': whenActive(0.85, 0.3),
                'line-width': whenActive(1.4, 0.8),
              },
            },
          ],
        }),
      })
    }

    const initMap = () => {
      if (map) {
        return
      }

      const maplibregl = window.maplibregl
      if (!maplibregl) {
        $<HTMLScriptElement>('[data-alcance-cdn]')?.addEventListener('load', initMap, {
          once: true,
          signal,
        })
        return
      }

      const instance = new maplibregl.Map({
        container: mapContainer,
        interactive: false,
        attributionControl: { compact: true },
      })
      map = instance

      applyStyle(instance, currentTheme)

      // El encuadre se deriva de los polígonos: agregar un estado lo reajusta.
      const bounds = new maplibregl.LngLatBounds()
      estadosGeoJson.features.forEach((feature) =>
        extendBounds(bounds, feature.geometry.coordinates),
      )

      const fitToEstados = () => instance.fitBounds(bounds, { ...mapFit, duration: 0 })

      fitToEstados()
      window.addEventListener('resize', fitToEstados, { signal })
    }

    const visibilityObserver = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          visibilityObserver.disconnect()
          initMap()
        }
      },
      { rootMargin: '300px' },
    )
    visibilityObserver.observe(section)

    // Theme - Map
    const themeObserver = new MutationObserver(() => {
      const nextTheme = getTheme()
      if (nextTheme === currentTheme) {
        return
      }
      currentTheme = nextTheme
      if (map) {
        applyStyle(map, nextTheme)
      }
    })
    themeObserver.observe(document.documentElement, { attributeFilter: ['data-theme'] })

    cleanupAlcance = () => {
      controller.abort()
      visibilityObserver.disconnect()
      themeObserver.disconnect()
      map?.remove()
      map = null
    }
  }

  document.addEventListener('astro:before-swap', () => {
    cleanupAlcance?.()
    cleanupAlcance = null
    activeSection = null
  })

  document.addEventListener('astro:page-load', setupAlcance)
  setupAlcance()
</script>

<style>
  /* Sin saturate: desaturaría también el estado resaltado, que va en color de marca. */
  [data-alcance-map] :global(.maplibregl-canvas) {
    filter: contrast(1.02);
  }

  [data-alcance-map] :global(.maplibregl-ctrl-attrib) {
    background: color-mix(in srgb, var(--vmv-background) 78%, transparent);
    font-size: 0.65rem;
  }

  [data-alcance-map] :global(.maplibregl-ctrl-attrib a) {
    color: var(--vmv-muted-foreground);
  }
</style>
