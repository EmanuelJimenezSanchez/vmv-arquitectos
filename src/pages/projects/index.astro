---
import Layout from '@/layouts/Layout.astro'
import Button from '@/components/ui/Button.astro'
import { projects } from '@/data/projects'

const title = 'Proyectos | VMV Arquitectos'
const description =
  'Portafolio de VMV Arquitectos: arquitectura, interiorismo y construcción en proyectos residenciales y comerciales.'
const canonical = 'https://www.vmv-arquitectos.com/projects'

const totalLabel = String(projects.length).padStart(2, '0')
const heroImage = projects[0]?.coverImage
const years = projects.map((project) => project.year)
const rangeLabel = years.length ? `${Math.min(...years)} — ${Math.max(...years)}` : ''
---

<Layout title={title} description={description} canonical={canonical}>
  <!-- ─── HERO ────────────────────────────────────────── -->
  <section
    class="relative flex h-[86svh] min-h-[30rem] items-center justify-center overflow-hidden bg-[#0f0e0c]"
    aria-labelledby="proyectos-title"
  >
    {
      heroImage && (
        <img
          src={heroImage}
          alt=""
          aria-hidden="true"
          class="absolute inset-0 h-full w-full scale-105 object-cover grayscale"
          data-proyectos-hero-image
          loading="eager"
          decoding="async"
        />
      )
    }
    <div class="absolute inset-0 bg-[#0f0e0c]/55" aria-hidden="true"></div>
    <div
      class="absolute inset-0 bg-linear-to-b from-[#0f0e0c]/70 via-transparent via-45% to-[#0f0e0c]/85"
      aria-hidden="true"
    >
    </div>

    <div
      class="relative z-2 flex flex-col items-center gap-[1.1rem] px-[clamp(1.25rem,5vw,3rem)] text-center"
      data-proyectos-hero-copy
    >
      <div class="h-11 w-px bg-white/50" aria-hidden="true"></div>
      <p class="vmv-overline-1 text-white/70">Portafolio</p>
      <h1 id="proyectos-title" class="vmv-title-1 max-w-[16ch] text-balance text-white">
        Proyectos
      </h1>
      <p class="vmv-body-2 max-w-[46ch] text-balance text-white/72">
        Espacios residenciales y comerciales donde diseño, interiorismo y obra se resuelven con un
        solo equipo.
      </p>
      <div class="h-11 w-px bg-white/50" aria-hidden="true"></div>
    </div>

    <div
      class="absolute inset-x-0 bottom-0 z-2 flex items-center justify-between gap-4 px-[clamp(1.25rem,5vw,3rem)] pb-[clamp(1.5rem,3vw,2.5rem)]"
      aria-hidden="true"
    >
      <span class="vmv-caption-1 tracking-[0.22em] text-white/55 uppercase">
        {totalLabel} proyectos
      </span>
      <span class="vmv-caption-1 tracking-[0.22em] text-white/55 uppercase tabular-nums">
        {rangeLabel}
      </span>
    </div>
  </section>

  <!-- ─── LISTADO EDITORIAL ───────────────────────────── -->
  <section class="relative bg-vmv-background py-[clamp(3.5rem,8vw,7rem)]" data-proyectos>
    <div class="mx-auto w-full max-w-[1200px] px-[clamp(1.25rem,5vw,3rem)]">
      <header class="flex flex-col gap-4" data-proyectos-intro>
        <p class="vmv-overline-1 flex items-center gap-3 text-vmv-sand-9">
          <span class="h-px w-9 bg-vmv-sand-9/60" aria-hidden="true"></span>
          Obra construida
        </p>
        <h2 class="vmv-title-2 max-w-[20ch] text-vmv-foreground">Selección de trabajos</h2>
      </header>

      <ol class="mt-[clamp(2.5rem,6vw,4.5rem)] flex flex-col">
        {
          projects.map((project, index) => (
            <li class="group border-t border-vmv-border last:border-b" data-proyectos-item>
              <a
                href={`/projects/${project.id}`}
                class="grid items-center gap-[clamp(1.5rem,3.5vw,3rem)] py-[clamp(2rem,4vw,3.25rem)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-vmv-ring md:grid-cols-[minmax(0,24rem)_1fr]"
                aria-label={`Ver proyecto ${project.title}`}
              >
                <figure
                  class:list={[
                    'relative aspect-[4/3] w-full overflow-hidden rounded-sm',
                    index % 2 === 1 && 'md:order-2',
                  ]}
                >
                  <div class="absolute inset-0 transition-transform duration-900 ease-vmv group-hover:scale-[1.05]">
                    <img
                      src={project.coverImage}
                      alt={`Vista del proyecto ${project.title}`}
                      class="h-full w-full object-cover grayscale transition-[filter] duration-700 ease-vmv group-hover:grayscale-0"
                      loading="lazy"
                      decoding="async"
                    />
                    <div
                      class="absolute inset-0 bg-vmv-sand-11/35 mix-blend-multiply transition-opacity duration-700 group-hover:opacity-0"
                      aria-hidden="true"
                    />
                  </div>
                  <div
                    class="pointer-events-none absolute inset-0 rounded-sm ring-1 ring-vmv-foreground/8 ring-inset"
                    aria-hidden="true"
                  />
                </figure>

                <div class="flex flex-col gap-4">
                  <div class="flex items-center gap-4">
                    <span
                      class="vmv-subtitle-1 shrink-0 text-vmv-sand-9/50 tabular-nums transition-colors duration-500 ease-vmv group-hover:text-vmv-sand-9"
                      aria-hidden="true"
                    >
                      {String(index + 1).padStart(2, '0')}
                    </span>
                    <span
                      class="h-px w-0 bg-vmv-foreground/45 transition-[width] duration-700 ease-vmv group-hover:w-12"
                      aria-hidden="true"
                    />
                  </div>

                  <h3 class="vmv-title-2 text-balance text-vmv-foreground transition-transform duration-700 ease-vmv group-hover:translate-x-1">
                    {project.title}
                  </h3>

                  <p class="vmv-caption-1 tracking-[0.22em] text-vmv-muted-foreground uppercase">
                    {project.location} · {project.year}
                  </p>

                  <p class="vmv-body-2 max-w-[52ch] text-vmv-muted-foreground">{project.summary}</p>

                  <ul class="flex flex-wrap items-center gap-x-3 gap-y-2">
                    {project.services.map((service) => (
                      <li class="vmv-caption-1 border border-vmv-border px-3 py-1 tracking-[0.16em] text-vmv-muted-foreground uppercase">
                        {service}
                      </li>
                    ))}
                  </ul>

                  <span class="vmv-button-1 mt-1 inline-flex items-center gap-3 text-vmv-foreground">
                    Ver proyecto
                    <span
                      class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-vmv-border transition-[transform,border-color,background-color,color] duration-500 ease-vmv group-hover:translate-x-1 group-hover:border-vmv-foreground group-hover:bg-vmv-foreground group-hover:text-vmv-background"
                      aria-hidden="true"
                    >
                      <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                        <path
                          d="M3 8h10M9 3.5L13.5 8 9 12.5"
                          stroke="currentColor"
                          stroke-width="1.3"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </span>
                  </span>
                </div>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ─── CTA ─────────────────────────────────────────── -->
  <section class="relative bg-[#0f0e0c] py-[clamp(3.5rem,8vw,6.5rem)]">
    <div
      class="mx-auto flex w-full max-w-[1200px] flex-col items-center gap-6 px-[clamp(1.25rem,5vw,3rem)] text-center"
    >
      <p class="vmv-overline-1 flex items-center gap-3 text-white/60">
        <span class="h-px w-9 bg-white/40" aria-hidden="true"></span>
        Siguiente proyecto
        <span class="h-px w-9 bg-white/40" aria-hidden="true"></span>
      </p>
      <h2 class="vmv-title-1 max-w-[18ch] text-balance text-white">¿Empezamos con el tuyo?</h2>
      <p class="vmv-body-2 max-w-[46ch] text-white/72">
        Cuéntanos qué tienes en mente y te acompañamos desde el primer trazo hasta la entrega.
      </p>
      <Button href="/#contacto" variant="white" size="xl" class="mt-2" data-contacto-trigger>
        Cuéntanos tu idea
      </Button>
    </div>
  </section>
</Layout>

<script>
  import gsap from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { $, $$ } from '@/lib/dom-selector'

  gsap.registerPlugin(ScrollTrigger)

  let cleanupProyectos: (() => void) | null = null

  const setupProyectos = () => {
    cleanupProyectos?.()
    cleanupProyectos = null

    const section = $<HTMLElement>('[data-proyectos]')
    if (!section) {
      return
    }

    const mm = gsap.matchMedia()

    mm.add('(prefers-reduced-motion: no-preference)', () => {
      const heroImage = $<HTMLElement>('[data-proyectos-hero-image]')
      const heroCopy = $<HTMLElement>('[data-proyectos-hero-copy]')
      const intro = $<HTMLElement>('[data-proyectos-intro]', section)
      const items = $$<HTMLElement>('[data-proyectos-item]', section)

      if (heroCopy) {
        gsap.from(heroCopy, { autoAlpha: 0, y: 32, duration: 1.1, ease: 'power3.out' })
      }

      if (heroImage?.parentElement) {
        gsap.to(heroImage, {
          yPercent: 12,
          ease: 'none',
          scrollTrigger: {
            trigger: heroImage.parentElement,
            start: 'top top',
            end: 'bottom top',
            scrub: true,
          },
        })
      }

      const revealed = [intro, ...items].filter(Boolean) as HTMLElement[]
      revealed.forEach((element) => {
        gsap.from(element, {
          autoAlpha: 0,
          y: 40,
          duration: 0.9,
          ease: 'power3.out',
          scrollTrigger: { trigger: element, start: 'top 85%' },
        })
      })
    })

    cleanupProyectos = () => mm.revert()
  }

  document.addEventListener('astro:before-swap', () => {
    cleanupProyectos?.()
    cleanupProyectos = null
  })

  document.addEventListener('astro:page-load', setupProyectos)
  setupProyectos()
</script>
