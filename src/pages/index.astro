---
import Proceso2 from '@/sections/Proceso2.astro';
import Layout from '../layouts/Layout.astro';
import Alcance from '../sections/Alcance.astro';
import Contacto from '../sections/Contacto.astro';
import Footer from '../sections/Footer.astro';
import Galeria from '../sections/Galeria.astro';
import Hero from '../sections/Hero.astro';
import Nosotros from '../sections/Nosotros.astro';
import Proceso from '../sections/Proceso.astro';
import Servicios from '../sections/Servicios.astro';

const SITE_URL = 'https://www.vmv-arquitectos.com'
const title = 'VMV Arquitectos | Diseño y construcción de espacios para habitar'
const description =
  'Despacho de arquitectura, interiorismo y construcción. Espacios residenciales y comerciales pensados para vivirse. Con base en Guadalajara y proyectos en todo México.'
const canonical = `${SITE_URL}/`

// El contenido viene de Supabase: se cachea en el edge un minuto y se sirve
// obsoleto mientras se revalida, para que editar en el panel no cueste latencia.
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=60, stale-while-revalidate=300',
)
---

<Layout title={title} description={description} canonical={canonical}>
	<Hero />
  <Nosotros />
  <!-- <Galeria /> -->
  <Servicios />
  <Alcance />
  <!-- <Proceso /> -->
  <Proceso2 />
  <Contacto />
</Layout>
