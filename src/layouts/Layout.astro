---
import { ClientRouter } from 'astro:transitions'
import Analytics from '@vercel/analytics/astro'

import '@/styles/global.css'

import Header from '../sections/Header.astro'
import Footer from '@/sections/Footer.astro'
import Button from '@/components/ui/Button.astro'
import ContactoModal from '@/components/ContactoModal.astro'
import SiteLoader from '@/components/SiteLoader.astro'
import MetaPixel from '@/components/MetaPixel.astro'
import CookieBanner from '@/components/CookieBanner.astro'
import { HTML_LANG, LOCALES, OG_LOCALE, getLocale, localizeHref, useTranslations } from '@/lib/i18n'
import {
  DEFAULT_OG_IMAGE,
  SITE_NAME,
  absoluteUrl,
  alternateUrls,
  localizedUrl,
  organizationSchema,
  websiteSchema,
} from '@/lib/seo'

interface Props {
  title?: string
  description?: string
  /** Ruta neutra (sin prefijo de idioma); el layout le aplica el del request. */
  canonical?: string
  robots?: string
  ogImage?: string
  ogImageAlt?: string
  ogUrl?: string
  ogType?: 'website' | 'article' | 'profile'
  /** Nodos extra del grafo JSON-LD (breadcrumbs, ficha del proyecto, etc.). */
  schema?: Record<string, unknown>[]
  /** Site chrome; disable on full-bleed routes (e.g. combate detail). */
  showHeader?: boolean
  /** Loader de carga inicial (spinner + frases). Solo corre una vez por sesión. */
  showLoader?: boolean
}

const locale = getLocale(Astro.url)
const t = useTranslations(locale)

const {
  title = t.seo.homeTitle,
  description = t.seo.homeDescription,
  canonical,
  robots,
  ogImage = DEFAULT_OG_IMAGE,
  ogImageAlt = t.seo.ogAlt,
  ogUrl,
  ogType = 'website',
  schema = [],
  showHeader = true,
  showLoader = true,
} = Astro.props

// La canónica se normaliza siempre sin barra final, que es la forma a la que
// redirige `vercel.json`; si no, apuntaría a una URL que responde 301.
const canonicalURL = canonical ? localizedUrl(canonical, locale) : absoluteUrl(Astro.url.pathname)
const finalOgUrl = ogUrl ? absoluteUrl(ogUrl) : canonicalURL
const finalOgImage = ogImage || DEFAULT_OG_IMAGE
const finalRobots =
  robots ?? 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'

// Las dos versiones de la página, para que Google las trate como traducciones
// entre sí en vez de como contenido duplicado.
const alternates = alternateUrls(canonical ?? Astro.url.pathname)
const otherLocales = LOCALES.filter((item) => item !== locale)

// Un solo bloque JSON-LD con todos los nodos: así las referencias cruzadas por
// `@id` se resuelven sin depender de que Google una scripts sueltos.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [organizationSchema(locale), websiteSchema(locale), ...schema],
}
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content={finalRobots} />
    <meta name="author" content={SITE_NAME} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fcfaf6" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1d1b18" />

    {
      alternates.map((alternate) => (
        <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
      ))
    }

    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {
      otherLocales.map((other) => (
        <meta property="og:locale:alternate" content={OG_LOCALE[other]} />
      ))
    }
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={finalOgUrl} />
    <meta property="og:image" content={finalOgImage} />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={finalOgImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!--
      Las portadas y el video del hero viven en CDN externo: abrir la conexión
      antes de que el parser llegue a ellos adelanta el LCP.
    -->
    <link rel="preconnect" href="https://cdn.vmv-arquitectos.com" crossorigin />
    <link rel="preconnect" href="https://pub-8c8a4bc70753408c9012d4e9ca17f103.r2.dev" crossorigin />

    <!--
      Tipografía definitiva: Manrope. Para volver a probar las demás opciones
      (selector en Header.astro), restaurar este href:
      https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,200;9..144,300;9..144,400;9..144,500&family=Inter:wght@300;400;500&family=Space+Grotesk:wght@300;400;500&family=Cormorant+Garamond:wght@300;400;500&family=Jost:wght@300;400;500&family=Manrope:wght@200;300;400;500&display=swap
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@200;300;400;500&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <script is:inline>
      ;(() => {
        const storageKey = 'vmv-theme'

        const getStoredTheme = () => {
          try {
            const stored = localStorage.getItem(storageKey)
            return stored === 'light' || stored === 'dark' ? stored : null
          } catch {
            return null
          }
        }

        const storedTheme = getStoredTheme()
        const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light'
        const resolvedTheme = storedTheme ?? systemTheme

        document.documentElement.classList.toggle('dark', resolvedTheme === 'dark')
        document.documentElement.setAttribute('data-theme', resolvedTheme)
      })()
    </script>

    <style is:global>
      /* Mientras el loader corre no debe haber scroll detrás. */
      html.is-loading,
      html.is-loading body {
        overflow: hidden;
      }
    </style>

    <slot name="head" />
    <ClientRouter />
    <Analytics />
    <MetaPixel />
  </head>
  <body>
    {showLoader && <SiteLoader />}
    {showHeader && <Header />}
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    {
      showHeader && (
        <div class="fixed right-4 bottom-4 z-60 flex items-center gap-3 md:right-8 md:bottom-8">
          <Button
            href={localizeHref('/#contacto', locale)}
            variant="gray"
            size="lg"
            class="shadow-lg"
            data-contacto-trigger
          >
            {t.nav.writeToUs}
          </Button>
          <a
            href="https://wa.me/15558241933"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={t.nav.whatsappAria}
            title={t.nav.whatsappAria}
            class="flex size-14 shrink-0 items-center justify-center rounded-full bg-[#25d366] text-white shadow-lg transition-transform duration-500 ease-vmv hover:-translate-y-0.5 focus-visible:ring-2 focus-visible:ring-vmv-ring focus-visible:ring-offset-2 focus-visible:ring-offset-vmv-background focus-visible:outline-none"
          >
            <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.870 9.870 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.860 9.860 0 01-1.510-5.260c.001-5.450 4.436-9.884 9.888-9.884 2.640 0 5.122 1.030 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.450-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.050 0C5.495 0 .160 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 00-3.480-8.413Z" />
            </svg>
          </a>
        </div>
      )
    }

    <ContactoModal />
    <CookieBanner />

    <script type="module">
      import { initLenis } from '../scripts/lenis.js'
      initLenis()
    </script>
  </body>
</html>
