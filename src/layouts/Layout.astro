---
import { ClientRouter } from 'astro:transitions'
import Analytics from '@vercel/analytics/astro'

import '@/styles/global.css'

import Header from '../sections/Header.astro'
import Footer from '@/sections/Footer.astro'
import Button from '@/components/ui/Button.astro'
import ContactoModal from '@/components/ContactoModal.astro'
import SiteLoader from '@/components/SiteLoader.astro'
import { HTML_LANG, LOCALES, OG_LOCALE, getLocale, localizeHref, useTranslations } from '@/lib/i18n'
import {
  DEFAULT_OG_IMAGE,
  SITE_NAME,
  absoluteUrl,
  alternateUrls,
  localizedUrl,
  organizationSchema,
  websiteSchema,
} from '@/lib/seo'

interface Props {
  title?: string
  description?: string
  /** Ruta neutra (sin prefijo de idioma); el layout le aplica el del request. */
  canonical?: string
  robots?: string
  ogImage?: string
  ogImageAlt?: string
  ogUrl?: string
  ogType?: 'website' | 'article' | 'profile'
  /** Nodos extra del grafo JSON-LD (breadcrumbs, ficha del proyecto, etc.). */
  schema?: Record<string, unknown>[]
  /** Site chrome; disable on full-bleed routes (e.g. combate detail). */
  showHeader?: boolean
  /** Loader de carga inicial (spinner + frases). Solo corre una vez por sesión. */
  showLoader?: boolean
}

const locale = getLocale(Astro.url)
const t = useTranslations(locale)

const {
  title = t.seo.homeTitle,
  description = t.seo.homeDescription,
  canonical,
  robots,
  ogImage = DEFAULT_OG_IMAGE,
  ogImageAlt = t.seo.ogAlt,
  ogUrl,
  ogType = 'website',
  schema = [],
  showHeader = true,
  showLoader = true,
} = Astro.props

// La canónica se normaliza siempre sin barra final, que es la forma a la que
// redirige `vercel.json`; si no, apuntaría a una URL que responde 301.
const canonicalURL = canonical ? localizedUrl(canonical, locale) : absoluteUrl(Astro.url.pathname)
const finalOgUrl = ogUrl ? absoluteUrl(ogUrl) : canonicalURL
const finalOgImage = ogImage || DEFAULT_OG_IMAGE
const finalRobots =
  robots ?? 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'

// Las dos versiones de la página, para que Google las trate como traducciones
// entre sí en vez de como contenido duplicado.
const alternates = alternateUrls(canonical ?? Astro.url.pathname)
const otherLocales = LOCALES.filter((item) => item !== locale)

// Un solo bloque JSON-LD con todos los nodos: así las referencias cruzadas por
// `@id` se resuelven sin depender de que Google una scripts sueltos.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [organizationSchema(locale), websiteSchema(locale), ...schema],
}
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content={finalRobots} />
    <meta name="author" content={SITE_NAME} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fcfaf6" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1d1b18" />

    {
      alternates.map((alternate) => (
        <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
      ))
    }

    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {
      otherLocales.map((other) => (
        <meta property="og:locale:alternate" content={OG_LOCALE[other]} />
      ))
    }
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={finalOgUrl} />
    <meta property="og:image" content={finalOgImage} />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={finalOgImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!--
      Las portadas y el video del hero viven en CDN externo: abrir la conexión
      antes de que el parser llegue a ellos adelanta el LCP.
    -->
    <link rel="preconnect" href="https://cdn.vmv-arquitectos.com" crossorigin />
    <link rel="preconnect" href="https://pub-8c8a4bc70753408c9012d4e9ca17f103.r2.dev" crossorigin />

    <!--
      Pruebas de tipografía (temporal): se cargan las 4 opciones a la vez
      para poder alternarlas solo cambiando las variables en global.css.
      Una vez elegida la definitiva, quitar este link y dejar solo las
      familias/weights realmente usados.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,200;9..144,300;9..144,400;9..144,500&family=Inter:wght@300;400;500&family=Space+Grotesk:wght@300;400;500&family=Cormorant+Garamond:wght@300;400;500&family=Jost:wght@300;400;500&family=Manrope:wght@200;300;400;500&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <script is:inline>
      ;(() => {
        const storageKey = 'vmv-theme'

        const getStoredTheme = () => {
          try {
            const stored = localStorage.getItem(storageKey)
            return stored === 'light' || stored === 'dark' ? stored : null
          } catch {
            return null
          }
        }

        const storedTheme = getStoredTheme()
        const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light'
        const resolvedTheme = storedTheme ?? systemTheme

        document.documentElement.classList.toggle('dark', resolvedTheme === 'dark')
        document.documentElement.setAttribute('data-theme', resolvedTheme)
      })()
    </script>

    <style is:global>
      /* Mientras el loader corre no debe haber scroll detrás. */
      html.is-loading,
      html.is-loading body {
        overflow: hidden;
      }
    </style>

    <slot name="head" />
    <ClientRouter />
    <Analytics />
  </head>
  <body>
    {showLoader && <SiteLoader />}
    {showHeader && <Header />}
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    {
      showHeader && (
        <div class="fixed right-4 bottom-4 z-60 flex flex-col items-end gap-3 md:right-8 md:bottom-8">
          <Button
            href={localizeHref('/#contacto', locale)}
            variant="gray"
            size="lg"
            class="shadow-lg"
            data-contacto-trigger
          >
            {t.nav.writeToUs}
          </Button>
        </div>
      )
    }

    <ContactoModal />

    <script type="module">
      import { initLenis } from '../scripts/lenis.js'
      initLenis()
    </script>
  </body>
</html>
