---
import Button from '@/components/ui/Button.astro'
import { getLocale, localizeHref, useTranslations } from '@/lib/i18n'

const locale = getLocale(Astro.url)
const t = useTranslations(locale)

interface Props {
  /** Prefijo de los `id` para poder montar el formulario más de una vez por página. */
  idPrefix?: string
  class?: string
}

const { idPrefix = 'contacto', class: className = '' } = Astro.props

const fieldClass =
  'vmv-body-2 w-full border-0 border-b border-vmv-border bg-transparent py-2.5 text-vmv-foreground outline-none transition-colors duration-300 placeholder:text-vmv-muted-foreground/50 focus:border-vmv-foreground'
const optionClass =
  'vmv-body-3 has-checked:border-vmv-foreground has-checked:bg-vmv-foreground has-checked:text-vmv-primary-foreground inline-flex cursor-pointer items-center gap-2 rounded-full border border-vmv-border px-5 py-2 text-vmv-foreground transition-colors duration-300'

const textFields = [
  { name: 'nombres', label: t.form.firstName, type: 'text', autocomplete: 'given-name' },
  { name: 'apellidos', label: t.form.lastName, type: 'text', autocomplete: 'family-name' },
  { name: 'email', label: t.form.email, type: 'email', autocomplete: 'email' },
  { name: 'telefono', label: t.form.phone, type: 'tel', autocomplete: 'tel' },
]

const radioGroups = [
  { name: 'considerando-construir', legend: t.form.consideringBuilding },
  { name: 'tiene-terreno', legend: t.form.hasLand },
]

/**
 * El valor viaja al correo tal cual, así que se manda siempre en español: el
 * equipo de VMV lee los avisos en un solo idioma sin importar en cuál escribió
 * el visitante.
 */
const radioOptions = [
  { value: 'Sí', label: t.form.yes },
  { value: 'No', label: t.form.no },
]
---

<div
  class:list={['relative', className]}
  data-contacto-wrapper
  data-locale={locale}
  data-origin={idPrefix}
  data-error-text={t.form.sendError}
  data-thank-you-href={localizeHref('/thank-you', locale)}
>
  <form class="flex flex-col gap-6" data-contacto-form novalidate>
    <div class="grid gap-6 sm:grid-cols-2">
      {
        textFields.map((field) => (
          <div class="flex flex-col gap-2">
            <label
              for={`${idPrefix}-${field.name}`}
              class="vmv-caption-1 text-vmv-muted-foreground"
            >
              {field.label}
            </label>
            <input
              id={`${idPrefix}-${field.name}`}
              name={field.name}
              type={field.type}
              autocomplete={field.autocomplete}
              required
              class={fieldClass}
            />
          </div>
        ))
      }
    </div>

    {
      radioGroups.map((group) => (
        <fieldset class="flex flex-col gap-3">
          <legend class="vmv-caption-1 text-vmv-muted-foreground">{group.legend}</legend>
          <div class="flex flex-wrap gap-3">
            {radioOptions.map((option) => (
              <label class={optionClass}>
                <input
                  type="radio"
                  name={`${idPrefix}-${group.name}`}
                  data-field={group.name}
                  value={option.value}
                  required
                  class="sr-only"
                />
                {option.label}
              </label>
            ))}
          </div>
        </fieldset>
      ))
    }

    <div class="flex flex-col gap-2">
      <label for={`${idPrefix}-mensaje`} class="vmv-caption-1 text-vmv-muted-foreground">
        {t.form.message}
      </label>
      <textarea
        id={`${idPrefix}-mensaje`}
        name="mensaje"
        rows="4"
        maxlength="2000"
        required
        placeholder={t.form.messagePlaceholder}
        class:list={[fieldClass, 'resize-y']}></textarea>
    </div>

    {/* Señuelo anti-spam: oculto para personas, irresistible para bots. */}
    <input
      type="text"
      name="website"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
      class="absolute left-[-9999px] h-0 w-0 opacity-0"
      data-contacto-honeypot
    />

    <p class="vmv-caption-1 text-vmv-muted-foreground">
      {t.form.note}
    </p>

    <p class="vmv-caption-1 text-vmv-muted-foreground">
      {t.form.privacyBefore}<a
        href={localizeHref('/privacy', locale)}
        target="_blank"
        class="underline underline-offset-2 transition-colors duration-300 hover:text-vmv-foreground"
        >{t.form.privacyLink}</a
      >{t.form.privacyAfter}
    </p>

    <Button type="submit" variant="primary" size="lg" class="mt-2 w-fit" data-contacto-submit>
      {t.form.submit}
    </Button>

    <p class="vmv-caption-1 hidden text-vmv-sand-11" data-contacto-error role="alert"></p>
  </form>
</div>

<script>
  import { actions } from 'astro:actions'
  import { navigate } from 'astro:transitions/client'
  import { $, $$ } from '@/lib/dom-selector'
  import { trackMeta } from '@/lib/meta-pixel'
  import { trackGA } from '@/lib/google-analytics'

  let formsController: AbortController | null = null

  const setupContactoForms = () => {
    formsController?.abort()
    formsController = new AbortController()
    const { signal } = formsController

    $$<HTMLElement>('[data-contacto-wrapper]').forEach((wrapper) => {
      const form = $<HTMLFormElement>('[data-contacto-form]', wrapper)
      if (!form) {
        return
      }

      const error = $<HTMLElement>('[data-contacto-error]', form)
      const submit = $<HTMLButtonElement>('[data-contacto-submit]', form)

      const value = (name: string) =>
        $<HTMLInputElement | HTMLTextAreaElement>(
          `input[name="${name}"], textarea[name="${name}"]`,
          form,
        )?.value.trim() ?? ''

      const radio = (field: string) =>
        $<HTMLInputElement>(`input[data-field="${field}"]:checked`, form)?.value ?? ''

      form.addEventListener(
        'submit',
        async (event) => {
          event.preventDefault()
          if (!form.reportValidity()) {
            return
          }

          error?.classList.add('hidden')
          if (submit) {
            submit.disabled = true
          }

          const considerandoConstruir = radio('considerando-construir')
          const tieneTerreno = radio('tiene-terreno')
          const idioma = wrapper.dataset.locale === 'en' ? 'en' : 'es'

          const { error: actionError } = await actions.contacto.enviar({
            nombres: value('nombres'),
            apellidos: value('apellidos'),
            email: value('email'),
            telefono: value('telefono'),
            mensaje: value('mensaje'),
            considerandoConstruir,
            tieneTerreno,
            idioma,
            website: $<HTMLInputElement>('[data-contacto-honeypot]', form)?.value ?? '',
          })

          if (actionError) {
            if (submit) {
              submit.disabled = false
            }
            if (error) {
              // El mensaje del servidor está en español; en la página se muestra
              // el del diccionario para no mezclar idiomas frente al visitante.
              error.textContent = wrapper.dataset.errorText ?? actionError.message
              error.classList.remove('hidden')
            }
            return
          }

          // Solo respuestas de calificación, nunca datos personales: sirven
          // para segmentar en Meta sin mandarle nombre, correo ni teléfono.
          trackMeta('Lead', {
            content_name: 'Formulario de contacto',
            form_origin: wrapper.dataset.origin ?? '',
            considering_building: considerandoConstruir,
            has_land: tieneTerreno,
            language: idioma,
          })
          // Evento recomendado de GA4; marcarlo como «evento clave» en GA.
          trackGA('generate_lead', {
            form_origin: wrapper.dataset.origin ?? '',
            considering_building: considerandoConstruir,
            has_land: tieneTerreno,
            language: idioma,
          })

          // Los eventos se mandan aquí y no en la página de gracias para que
          // recargarla o entrar directo no cuente leads de más. El ClientRouter
          // navega sin descargar la página, así que no cortan su envío. El
          // botón queda deshabilitado: el formulario desaparece con la página.
          form.reset()
          void navigate(wrapper.dataset.thankYouHref ?? '/gracias')
        },
        { signal },
      )
    })
  }

  document.addEventListener('astro:before-swap', () => {
    formsController?.abort()
    formsController = null
  })

  document.addEventListener('astro:page-load', setupContactoForms)
  setupContactoForms()
</script>
