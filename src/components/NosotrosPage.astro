---
import { getGaleria } from '@/lib/content'
import Button from '@/components/ui/Button.astro'

const BUCKET_URL = `${import.meta.env.R2_BUCKET_URL}/nosotros`;

const galeria = await getGaleria()
---

<section id="nosotros" class="relative">
  <!-- ─── HERO: CORTINA + FRASE ICÓNICA ──────────────── -->
  <div
    data-nosotros="hero"
    class="relative h-dvh overflow-hidden bg-vmv-gray-1 motion-reduce:hidden"
  >
    <div
      data-nosotros="panel-l"
      class="absolute top-0 left-0 z-10 h-full w-1/2 overflow-hidden after:pointer-events-none after:absolute after:inset-0 after:bg-linear-to-r after:from-[#0f0e0c]/10 after:to-[#0f0e0c]/55"
    >
      <img
        src={`${BUCKET_URL}/nosotros-1.webp`}
        alt="Diseño arquitectónico VMV Arquitectos"
        class="block h-full w-full object-cover object-[40%_center]"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div
      data-nosotros="panel-r"
      class="absolute top-0 right-0 z-10 h-full w-1/2 overflow-hidden after:pointer-events-none after:absolute after:inset-0 after:bg-linear-to-l after:from-[#0f0e0c]/10 after:to-[#0f0e0c]/55"
    >
      <img
        src={`${BUCKET_URL}/nosotros-2.webp`}
        alt="Construcción de lujo VMV Arquitectos"
        class="block h-full w-full object-cover object-[60%_center]"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div
      data-nosotros="label"
      class="pointer-events-none absolute top-1/2 left-1/2 z-20 flex -translate-x-1/2 -translate-y-1/2 flex-col items-center gap-[1.1rem] whitespace-nowrap"
    >
      <div class="h-11 w-px bg-vmv-sand-1/50" aria-hidden="true"></div>
      <span class="vmv-title-1 text-white"> NOSOTROS </span>
      <div class="h-11 w-px bg-vmv-sand-1/50" aria-hidden="true"></div>
      <!-- <div data-nosotros="label-cta" class="pointer-events-auto mt-[0.6rem]">
        <Button href="/#contacto" variant="white" size="lg" data-contacto-trigger>Conócenos</Button>
      </div> -->
    </div>

    <div
      data-nosotros="scroll-hint"
      class="absolute bottom-9 left-1/2 z-20 -translate-x-1/2"
      aria-hidden="true"
    >
      <span
        class="scroll-drop block h-14 w-px bg-linear-to-b from-vmv-sand-1/0 via-vmv-sand-1/65 to-vmv-sand-1/0"
      ></span>
    </div>

    <div
      data-nosotros="galeria-media"
      class="pointer-events-none absolute top-1/2 left-1/2 z-6 -translate-x-1/2 -translate-y-1/2 overflow-hidden opacity-0"
      aria-hidden="true"
    >
      <div class="relative h-full w-full">
        {
          galeria.map((item, index) => (
            <picture>
              <source media="(max-width: 767px)" srcset={item.images.mobile} />
              <img
                src={item.images.desktop}
                alt={item.description}
                class={`absolute inset-0 block h-full w-full object-cover ${index === 0 ? 'opacity-100' : 'opacity-0'}`}
                data-nosotros="galeria-image"
                loading="eager"
                decoding="async"
              />
            </picture>
          ))
        }
      </div>
    </div>

    <div
      data-nosotros="galeria-copy"
      class="pointer-events-none absolute inset-0 z-7 flex flex-col items-center justify-center gap-[0.08em] px-[clamp(1rem,4vw,3rem)] text-center"
    >
      <!-- <p
        data-nosotros="galeria-main"
        class="vmv-title-1 mx-auto max-w-[24ch] text-balance text-vmv-sand-1 [text-shadow:0_14px_30px_rgba(0,0,0,0.35)]"
      >
        Diseño, interiorismo y construcción a tu medida. Un solo equipo, del primer trazo a la
        última llave.
      </p> -->
      <div data-nosotros="galeria-cta" class="pointer-events-auto mt-[clamp(1.5rem,3vw,2.5rem)]">
        <Button href="/#contacto" variant="white" size="xxl" data-contacto-trigger>Conócenos</Button>
      </div>
      <!-- <div data-nosotros="restart-cta" class="pointer-events-auto mt-[clamp(0.9rem,2.2vw,1.4rem)]">
        <button
          type="button"
          data-nosotros="restart"
          class="group vmv-button-1 inline-flex cursor-pointer items-center gap-2 border-none bg-transparent tracking-[0.16em] text-white uppercase opacity-90 transition-opacity duration-300 [text-shadow:0_2px_10px_rgba(0,0,0,0.45)] hover:opacity-100"
        >
          Reiniciar animación
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
            class="shrink-0 transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:rotate-180"
            style="filter: drop-shadow(0 2px 6px rgba(0,0,0,0.45));"
          >
            <path
              d="M20 12a8 8 0 1 1-2.34-5.66"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
            <path
              d="M20 4v5h-5"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
      </div> -->
    </div>

    <div
      data-nosotros="reveal"
      class="pointer-events-none absolute inset-0 z-8 flex flex-col items-center justify-center px-[clamp(2rem,9vw,7rem)]"
    >
      <p data-nosotros="reveal-text" class="vmv-title-2 max-w-3xl text-center text-vmv-gray-12">
        El lujo está en el detalle. Nosotros lo cuidamos por ti.
      </p>
      <!-- <div data-nosotros="reveal-cta" class="pointer-events-auto mt-[clamp(1.5rem,3vw,2.5rem)]">
        <Button href="/#contacto" variant="white" size="xl" data-contacto-trigger
          >Ponte en contacto</Button
        >
      </div> -->
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { SplitText } from 'gsap/SplitText'
  import { Observer } from 'gsap/Observer'
  import { $, $$ } from '@/lib/dom-selector'

  gsap.registerPlugin(ScrollTrigger, SplitText, Observer)

  const activeTriggers: ScrollTrigger[] = []
  let revealSplit: SplitText | null = null
  let scrollLocked = false

  // Bloquea el scroll (wheel/touch) mientras la intro del hero se
  // reproduce sola: antes se intentaba "corregir" el scroll ya ocurrido
  // devolviéndolo al inicio del pin en cada tick, pero eso saltaba la
  // posición hasta el top de la página en cada intento de scroll y
  // disparaba el estado "scrolled: false" del header (parecía que la
  // página se scrolleaba sola hacia arriba). Prevenir el scroll de raíz
  // evita ese efecto.
  const observer = Observer.create({
    preventDefault: true,
    type: 'wheel,touch,pointer',
    enabled: false,
  })

  function killAll() {
    activeTriggers.forEach((t) => t.kill())
    activeTriggers.length = 0
    revealSplit?.revert()
    revealSplit = null
    unlockScroll()
  }

  // El bloqueo va en tres capas porque ninguna cubre todas las formas de
  // scrollear:
  //  1. Observer: frena wheel/touch/pointer antes de que lleguen a nadie.
  //  2. Lenis: es quien realmente mueve la página (y su plugin de snap
  //     puede lanzar scrolls por su cuenta); `stop()` también hace que sus
  //     `scrollTo` internos se ignoren.
  //  3. `overflow: clip` en el root: lo único que impide el scroll nativo
  //     por teclado, barra de scroll o Home/End. No altera la posición
  //     actual (es el mismo mecanismo que usa Lenis con `autoToggle`).
  // `alignTo` reubica el scroll justo antes de cerrar el candado: hay que
  // hacerlo con Lenis ya detenido (si no, su inercia lo deshace en el
  // siguiente frame) pero antes del `overflow: clip`, que también bloquea
  // el scroll programático.
  function lockScroll(alignTo?: number) {
    scrollLocked = true
    observer.enable()
    window.lenis?.stop()
    if (alignTo != null) window.scrollTo(0, alignTo)
    document.documentElement.style.setProperty('overflow', 'clip')
  }

  function unlockScroll() {
    scrollLocked = false
    observer.disable()
    document.documentElement.style.removeProperty('overflow')
    window.lenis?.start()
  }

  function initNosotros() {
    killAll()

    // ── HERO ─────────────────────────────────────────
    const hero = $<HTMLElement>('[data-nosotros="hero"]')
    const panelL = $<HTMLElement>('[data-nosotros="panel-l"]')
    const panelR = $<HTMLElement>('[data-nosotros="panel-r"]')
    const label = $<HTMLElement>('[data-nosotros="label"]')
    const scrollHint = $<HTMLElement>('[data-nosotros="scroll-hint"]')
    const revealEl = $<HTMLElement>('[data-nosotros="reveal"]')
    const revealText = $<HTMLParagraphElement>('[data-nosotros="reveal-text"]')
    // const revealImgs  = $$<HTMLElement>('[data-nosotros="reveal-img"]');
    const galeriaMedia = $<HTMLElement>('[data-nosotros="galeria-media"]')
    const galeriaImages = $$<HTMLElement>('[data-nosotros="galeria-image"]')
    const galeriaCopy = $<HTMLElement>('[data-nosotros="galeria-copy"]')
    // const galeriaMain = $<HTMLParagraphElement>('[data-nosotros="galeria-main"]')
    const galeriaCta = $<HTMLElement>('[data-nosotros="galeria-cta"]')

    if (!hero || !panelL || !panelR || !label || !revealEl || !revealText) return

    // Word-spans
    revealSplit = SplitText.create(revealText, { type: 'words', aria: 'auto' })

    gsap.set(revealEl, { opacity: 0 })
    gsap.set(revealSplit.words, { opacity: 0.5 })
    // gsap.set(revealImgs, { opacity: 0, scale: 0.85 });

    const hasGaleriaCopy = galeriaCopy && galeriaCta

    if (hasGaleriaCopy) {
      // gsap.set(galeriaCopy, { opacity: 0 })
      // gsap.set(galeriaMain, { opacity: 0, y: 10 })
      gsap.set(galeriaCta, { opacity: 0, y: 20 })
    }

    // Solo la última imagen queda visible al terminar el ciclo de swap, y
    // las demás se ocultan con `.set()` (instantáneo) en vez de un tween: un
    // `.set()` no es reversible al rebobinar el timeline, así que
    // `heroTl.restart()` por sí solo NO devuelve las imágenes a su estado
    // inicial (la primera en opacity 1, el resto en 0). Sin este reset
    // manual, un reinicio deja la última imagen del ciclo anterior visible
    // mientras las siguientes vuelven a aparecer encima, y se ven encimadas.
    const resetGaleriaMedia = () => {
      if (!galeriaMedia) return
      gsap.set(galeriaMedia, {
        width: '16rem',
        height: '16rem',
        borderRadius: '999px',
        opacity: 0,
      })
      gsap.set(galeriaImages, { opacity: 0 })
      if (galeriaImages[0]) gsap.set(galeriaImages[0], { opacity: 1 })
    }

    resetGaleriaMedia()

    const heroTl = gsap.timeline({
      paused: true,
    })

    heroTl
      .to([label, scrollHint], {
        opacity: 0,
        y: -50,
        duration: 0.6,
        ease: 'power2.in',
        delay: 0.1,
      })
      .to(panelL, { xPercent: -100, ease: 'power2.inOut', duration: 1.4 }, '<')
      .to(panelR, { xPercent: 100, ease: 'power2.inOut', duration: 1.4 }, '<')
      .to(revealEl, { opacity: 1, duration: 0.35, ease: 'power2.out' }, 1)
      .to(revealSplit.words, {
        // color: 'rgba(255,255,255,0.92)',
        opacity: 1,
        stagger: { each: 0.08 },
        duration: 0.08,
        ease: 'none',
      })

    // ── GALERIA REVEAL (controlada por scroll) ────────
    // A partir de aquí la animación ya no se reproduce sola: queda en un
    // timeline aparte que se liga al scroll (pin + scrub). El
    // ScrollTrigger se crea aquí mismo (síncrono, antes que el de
    // "about" más abajo) para que el resto de las secciones calculen su
    // posición ya contando con el espacio extra que reserva este pin;
    // crearlo más tarde (p. ej. en un callback tras la intro) desplaza el
    // documento a mitad de sesión y provoca que "Servicios" se sobreponga
    // con el hero todavía pineado.
    const heroScrollTl = gsap.timeline({ paused: true })
    let galeriaScrollTrigger: ScrollTrigger | null = null
    let introDone = false

    // Red de seguridad para cuando el scrub ya avanzó sin que la intro se
    // haya reproducido (p. ej. al recargar la página con el scroll
    // restaurado dentro del pin). Si `heroTl` siguiera reproduciéndose en
    // ese estado, ambos timelines animarían la opacidad de `revealEl` a la
    // vez y ganaría el último en renderizar: el texto se quedaba visible
    // encima de la galería ya expandida. Durante el flujo normal esto no
    // se dispara, porque el scroll está bloqueado hasta que la intro
    // termina (ver lockScroll).
    const completeIntro = () => {
      if (introDone) return
      introDone = true
      // `suppressEvents` evita que se dispare el onComplete y se llame
      // a esta misma función en bucle.
      heroTl.progress(1, true).pause()
      // La intro deja `revealEl` en su valor final, así que hay que volver
      // a pintar el timeline del scroll para que mande su estado actual.
      heroScrollTl.render(heroScrollTl.time(), false, true)
      unlockScroll()
    }

    if (galeriaMedia && galeriaImages.length > 0) {
      heroScrollTl.addLabel('galeriaReveal', 0)

      const scaleStartOffset = 0.5
      const scaleDuration = 2
      const imageSwapStart = scaleStartOffset + 0.1
      const imageSwapDuration = 0.03

      heroScrollTl
        // .to({}, { duration: 0.8 })}
        .to(galeriaMedia, { opacity: 1, duration: 1, ease: 'none' })
        .fromTo(
          revealEl,
          { opacity: 1, scale: 1 },
          { opacity: 0, scale: 0.95, duration: 0.4, ease: 'power2.in', immediateRender: false },
          'galeriaReveal',
        )
        .to(
          galeriaMedia,
          {
            width: '100vw',
            height: '100vh',
            borderRadius: '0px',
            duration: scaleDuration,
            ease: 'none',
          },
          `galeriaReveal+=${scaleStartOffset}`,
        )

      const imageCycleEnd = scaleStartOffset + scaleDuration
      const swapCount = galeriaImages.length - 1
      if (swapCount > 0) {
        const swapSpacing =
          swapCount > 1 ? (scaleDuration - 0.3 - imageSwapDuration) / (swapCount - 1) : 0

        // La imagen nueva (más adelante en el DOM) queda apilada sobre la
        // anterior, así que se desvanece encima de ella y ambas permanecen
        // visibles durante toda la transición: la anterior solo se oculta
        // una vez que la nueva ya la cubre por completo, sin parpadeo.
        galeriaImages.slice(1).forEach((image, i) => {
          const previousImage = galeriaImages[i]
          const swapTime = imageSwapStart + i * swapSpacing

          heroScrollTl
            .to(
              image,
              { opacity: 1, duration: imageSwapDuration, ease: 'none' },
              `galeriaReveal+=${swapTime}`,
            )
            .set(previousImage, { opacity: 0 }, `galeriaReveal+=${swapTime + imageSwapDuration}`)
        })
      }

      // Frase de conversión y botón de contacto: el mismo remate que tiene
      // Galeria.astro al final de su animación, ahora aparece cuando el
      // ciclo de imágenes de la galería termina.
      if (hasGaleriaCopy) {
        heroScrollTl.addLabel('galeriaCopyReveal', `galeriaReveal+=${imageCycleEnd + 0.2}`)

        heroScrollTl
          // .to(
          //   [galeriaCopy, galeriaCta],
          //   { opacity: 1, duration: 0.4, ease: 'power2.out' },
          //   'galeriaCopyReveal',
          // )
          // .to(
          //   galeriaMain,
          //   { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' },
          //   'galeriaCopyReveal',
          // )
          .to(
            galeriaCta,
            { opacity: 1, y: 0, duration: 0.3, ease: 'power2.out' },
            'galeriaCopyReveal+=0.4',
          )
          // Espacio "muerto" al final: mantiene el pin un poco más luego de
          // que aparece el botón, para que haga falta seguir scrolleando
          // antes de pasar a la siguiente sección.
          .to({}, { duration: 0.8 })
      }

      // El hero queda pineado desde que entra, y mientras la intro
      // (heroTl) se reproduce el scroll está bloqueado (ver lockScroll),
      // así que la revelación de la galería no puede avanzar hasta que
      // termine.
      galeriaScrollTrigger = ScrollTrigger.create({
        trigger: hero,
        start: 'top top',
        end: '+=310%',
        pin: true,
        scrub: 1,
        animation: heroScrollTl,
        // Si el scrub avanza con la intro sin terminar y sin el candado
        // puesto, la intro ya no puede seguir animando por su cuenta (ver
        // completeIntro). Se difiere un frame porque este `onUpdate` y el
        // `onEnter` que arranca la intro pueden caer en el mismo update:
        // para entonces el candado ya está puesto y no hace falta.
        onUpdate: (self) => {
          if (introDone || scrollLocked || self.progress === 0) return
          requestAnimationFrame(() => {
            if (!introDone && !scrollLocked && (galeriaScrollTrigger?.progress ?? 0) > 0) {
              completeIntro()
            }
          })
        },
        // Al volver a cruzar el borde superior de la sección hacia arriba
        // (scroll hacia atrás más allá del pin), la revelación de la
        // galería ya se revierte sola por el scrub; pero la intro
        // (heroTl) no está atada al scroll, así que hay que revertirla
        // a mano para volver al hero tal como se ve al cargar la página.
        onLeaveBack: () => {
          introDone = false
          heroTl.eventCallback('onReverseComplete', null)
          heroTl.reverse()
        },
      })
      activeTriggers.push(galeriaScrollTrigger)

      heroTl.eventCallback('onComplete', completeIntro)
    }

    // Espera a que las imágenes de la galería estén cargadas y decodificadas
    // antes de reproducir la animación, para evitar el parpadeo del swap.
    const galeriaImagesReady =
      galeriaImages.length === 0
        ? Promise.resolve()
        : Promise.all(
            galeriaImages.map((img) => {
              const image = img as HTMLImageElement
              const decode = () =>
                image.decode ? image.decode().catch(() => {}) : Promise.resolve()
              // Sin `src` el navegador no dispara ni `load` ni `error`: la
              // promesa quedaría pendiente para siempre y, con ella, la intro
              // sin arrancar y el scroll bloqueado.
              if (!image.currentSrc && !image.getAttribute('src')) {
                return Promise.resolve()
              }
              if (image.complete && image.naturalWidth > 0) {
                return decode()
              }
              return new Promise<void>((resolve) => {
                image.addEventListener('load', () => resolve(), { once: true })
                image.addEventListener('error', () => resolve(), { once: true })
              }).then(decode)
            }),
          ).then(() => undefined)

    const heroSt = ScrollTrigger.create({
      trigger: hero,
      // Prácticamente el mismo punto que el pin de la galería: el candado
      // se cierra cuando la sección ya está encuadrada contra el borde
      // superior, no antes (con `top 05%` se bloqueaba con la sección
      // anterior todavía asomada). Los 4px de adelanto no se notan, pero
      // son necesarios: con un `start` idéntico al del pin, este trigger
      // se mide sobre el hero ya pineado y su punto de inicio se corre
      // hasta el final del pin, así que la intro nunca arrancaba.
      start: 'top top+=4',
      onEnter: () => {
        if (introDone) return
        // En un scroll rápido, ScrollTrigger detecta el cruce con el punto
        // de inicio ya pasado, así que el scrub habría avanzado unos
        // píxeles. El hero ya está pineado, por lo que devolver el scroll
        // al inicio del pin no mueve nada en pantalla: solo deja el
        // timeline de la galería en cero para que la intro arranque limpia.
        const pinStart = galeriaScrollTrigger?.start
        const overshot = pinStart != null && window.scrollY > pinStart
        lockScroll(overshot ? pinStart : undefined)
        if (overshot) heroScrollTl.progress(0)
        galeriaImagesReady.then(() => {
          // `introDone` puede haberse resuelto mientras se esperaban las
          // imágenes (ver completeIntro): en ese caso reproducir la intro
          // la pondría encima de la galería ya revelada.
          if (introDone) return
          heroTl.play()
        })
      },
    })

    activeTriggers.push(heroSt)

    const restartButton = $<HTMLButtonElement>('[data-nosotros="restart"]')
    restartButton?.addEventListener('click', () => {
      lockScroll()
      introDone = false
      heroScrollTl.pause(0)
      resetGaleriaMedia()
      // Devuelve el scroll al inicio del pin para que el scrub (ligado a
      // la posición de scroll) no vuelva a arrastrar el timeline a donde
      // estaba antes de reiniciar.
      if (galeriaScrollTrigger) galeriaScrollTrigger.scroll(galeriaScrollTrigger.start)
      heroTl.restart()
    })

    // ── ABOUT (solo en pantallas grandes) ────────────
    const isDesktop = window.matchMedia('(min-width: 768px)').matches
    const isPrefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    if (isDesktop && !isPrefersReducedMotion) {
      const aboutSection = $<HTMLElement>('[data-nosotros="about"]')
      const aboutLeft = $<HTMLElement>('[data-nosotros="about-left"]')
      const aboutRight = $<HTMLElement>('[data-nosotros="about-right"]')
      const infoPanel = $<HTMLElement>('[data-nosotros="panel-info"]')
      const servicesPanel = $<HTMLElement>('[data-nosotros="panel-services"]')
      const imgLayer1 = $<HTMLElement>('[data-nosotros="img-layer-1"]')
      const imgLayer2 = $<HTMLElement>('[data-nosotros="img-layer-2"]')
      const navDot1 = $<HTMLElement>('[data-nosotros="nav-dot-1"]')
      const navDot2 = $<HTMLElement>('[data-nosotros="nav-dot-2"]')
      const navFill = $<HTMLElement>('[data-nosotros="nav-fill"]')

      if (
        !aboutSection ||
        !aboutLeft ||
        !aboutRight ||
        !infoPanel ||
        !servicesPanel ||
        !imgLayer1 ||
        !imgLayer2
      )
        return

      // Estado inicial
      gsap.set(aboutLeft, { x: -60, opacity: 0 })
      gsap.set(aboutRight, { x: 60, opacity: 0, scale: 1.05 })
      gsap.set(servicesPanel, { yPercent: 100 })
      gsap.set(imgLayer2, { opacity: 0 })

      // Nav: dot 1 activo al inicio
      navDot1?.setAttribute('data-active', '')

      // Fase 0: Entrada cuando el about entra al viewport (antes del pin)
      activeTriggers.push(
        ScrollTrigger.create({
          trigger: aboutSection,
          start: 'top 78%',
          once: true,
          onEnter: () => {
            gsap.to(aboutLeft, { x: 0, opacity: 1, duration: 1.1, ease: 'power3.out' })
            gsap.to(aboutRight, {
              x: 0,
              opacity: 1,
              scale: 1,
              duration: 1.3,
              ease: 'power3.out',
              delay: 0.08,
            })
          },
        }),
      )

      // Fase 1→2: Pin + swap de contenido al hacer scroll
      const aboutTl = gsap.timeline({
        scrollTrigger: {
          trigger: aboutSection,
          start: 'top top',
          end: '+=300%',
          scrub: 1,
          pin: true,
          anticipatePin: 1,
          onUpdate: (self) => {
            const p = self.progress
            // Relleno del track proporcional al progreso del scroll
            if (navFill) navFill.style.height = `${p * 100}%`
            // Cambio de dot activo cuando el swap de paneles ocurre
            // (~0.52 del timeline / 1.35 de total ≈ 40% del scroll)
            const inPhase2 = p > 0.4
            navDot1?.toggleAttribute('data-active', !inPhase2)
            navDot2?.toggleAttribute('data-active', inPhase2)
          },
        },
      })

      aboutTl
        .to(infoPanel, { yPercent: -100, opacity: 0, duration: 0.38, ease: 'power2.in' }, 0.38)
        .to(imgLayer1, { opacity: 0, duration: 0.32, ease: 'power2.inOut' }, 0.42)
        .to(servicesPanel, { yPercent: 0, duration: 0.44, ease: 'power3.out' }, 0.56)
        .to(imgLayer2, { opacity: 1, duration: 0.38, ease: 'power2.inOut' }, 0.54)

      const aboutSt = aboutTl.scrollTrigger
      if (aboutSt) activeTriggers.push(aboutSt)
    }
  }

  document.addEventListener('astro:before-swap', killAll)
  document.addEventListener('astro:page-load', initNosotros)
  initNosotros()
</script>

<style>
  .scroll-drop {
    animation: scroll-drop 2.2s ease-in-out infinite;
  }

  @keyframes scroll-drop {
    0% {
      transform: translateY(-40%) scaleY(0.5);
      opacity: 0;
    }
    40% {
      opacity: 1;
    }
    100% {
      transform: translateY(40%) scaleY(0.5);
      opacity: 0;
    }
  }
</style>
