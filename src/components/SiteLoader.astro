---
import logoVmv from '@/assets/svg/logo-vmv.svg'

interface Props {
  /** Frases que aparecen tras la carga; cada una se anima palabra por palabra. */
  phrases?: string[]
}

const { phrases = ['Espacios pensados para habitar', 'Diseño, detalle y oficio'] } =
  Astro.props as Props

// Marcas radiales del spinner: la longitud alterna para dar el trazo irregular
// de la referencia. No giran: crecen y se encogen en secuencia alrededor del aro.
const TICK_COUNT = 56
const ticks = Array.from({ length: TICK_COUNT }, (_, index) => ({
  angle: (360 / TICK_COUNT) * index,
  length: 42 + Math.round(Math.abs(Math.sin(index * 1.7)) * 22),
  opacity: 0.4 + Math.abs(Math.sin(index * 0.9)) * 0.6,
}))
---

<div
  id="site-loader"
  class="vmv-loader"
  role="status"
  aria-live="polite"
  aria-label="Cargando VMV Arquitectos"
>
  <div class="vmv-loader__stage" data-loader-spinner>
    <!-- <div class="vmv-loader__ring">
      {
        ticks.map((tick) => (
          <span
            class="vmv-loader__tick"
            style={`--tick-angle:${tick.angle}deg;--tick-length:${tick.length}px;opacity:${tick.opacity}`}
          >
            <span class="vmv-loader__tick-line" data-loader-tick />
          </span>
        ))
      }
    </div> -->

    <span
      class="vmv-loader__logo"
      style={`--logo-mask:url(${logoVmv.src})`}
      aria-label="VMV Arquitectos"
      data-loader-logo
    >
      <span class="vmv-loader__logo-fill"></span>
    </span>
  </div>

  <div class="vmv-loader__phrases" data-loader-phrases aria-hidden="true">
    {
      phrases.map((phrase) => (
        <p class="vmv-loader__phrase" data-loader-phrase>
          {phrase.split(' ').map((word) => (
            <span class="vmv-loader__word">
              <span class="vmv-loader__word-inner" data-loader-word>
                {word}
              </span>
            </span>
          ))}
        </p>
      ))
    }
  </div>
</div>

<style>
  /* El script inline de Layout.astro resuelve el tema antes de pintar, así que
     estos tokens ya son los correctos cuando el loader aparece. */
  .vmv-loader {
    --loader-bg: var(--vmv-background, #17191b);
    --loader-ink: var(--vmv-foreground, #f5f3f0);
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    background-color: var(--loader-bg);
    color: var(--loader-ink);
    will-change: opacity;
  }

  .vmv-loader__stage {
    position: relative;
    display: grid;
    place-items: center;
    width: 420px;
    height: 420px;
  }

  .vmv-loader__ring {
    position: absolute;
    inset: 0;
  }

  /* El contenedor solo coloca la marca en su ángulo; la línea interior es la
     que escala, con origen en el extremo cercano al centro. */
  .vmv-loader__tick {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2px;
    height: var(--tick-length, 40px);
    transform: rotate(var(--tick-angle)) translate(-50%, -184px);
    transform-origin: top left;
  }

  .vmv-loader__tick-line {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 1px;
    background-color: var(--loader-ink);
    -webkit-mask-image: linear-gradient(to top, transparent, #000);
    mask-image: linear-gradient(to top, transparent, #000);
    transform-origin: bottom center;
    will-change: transform, opacity;
  }

  /* El logo es la máscara: dentro se pinta una base tenue y encima el relleno
     que sube según el progreso real de carga (--logo-fill: 0 -> 1). */
  .vmv-loader__logo {
    --logo-fill: 0;
    --logo-edge: 0;
    position: relative;
    display: block;
    width: 220px;
    aspect-ratio: 1920 / 725;
    background-color: color-mix(in srgb, var(--loader-ink) 16%, transparent);
    -webkit-mask-image: var(--logo-mask);
    mask-image: var(--logo-mask);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-size: contain;
    mask-size: contain;
  }

  /* El degradado de la máscara difumina el borde superior, así el relleno se
     lee como líquido y no como un corte recto. */
  .vmv-loader__logo-fill {
    position: absolute;
    inset: 0;
    background-color: var(--loader-ink);
    -webkit-mask-image: linear-gradient(
      to top,
      #000 calc(var(--logo-fill) * 100%),
      transparent calc(var(--logo-fill) * 100% + 9%)
    );
    mask-image: linear-gradient(
      to top,
      #000 calc(var(--logo-fill) * 100%),
      transparent calc(var(--logo-fill) * 100% + 9%)
    );
    will-change: mask-image;
  }

  /* Línea de avance: la máscara del logo la recorta, así que solo se ve sobre
     el trazo. */
  .vmv-loader__logo::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(var(--logo-fill) * 100%);
    height: 2px;
    background-color: color-mix(in srgb, var(--loader-ink) 90%, transparent);
    opacity: var(--logo-edge);
  }

  .vmv-loader__phrases {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding-inline: 1.5rem;
    pointer-events: none;
  }

  .vmv-loader__phrase {
    grid-area: 1 / 1;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 0.32em;
    max-width: 22ch;
    text-align: center;
    font-family: var(--font-display, sans-serif);
    font-size: clamp(2rem, 7vw, 4.5rem);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.02em;
    opacity: 0;
  }

  .vmv-loader__word {
    display: block;
    overflow: hidden;
    padding-block: 0.08em;
  }

  .vmv-loader__word-inner {
    display: block;
    will-change: transform;
  }

  @media (max-width: 640px) {
    .vmv-loader__stage {
      transform: scale(0.62);
    }
  }
</style>

<script>
  import { gsap } from 'gsap'
  import { $, $$ } from '@/lib/dom-selector'

  // El spinner se ve un mínimo aunque los medios ya estén en caché.
  const MIN_SPINNER_MS = 1800
  const MAX_WAIT_MS = 7000

  type LenisLike = { start: () => void; stop: () => void }

  const getLenis = () => (window as unknown as { lenis?: LenisLike }).lenis ?? null

  const markDone = () => {
    document.documentElement.classList.remove('is-loading')
    getLenis()?.start()
  }

  const wait = (ms: number) => new Promise<void>((resolve) => window.setTimeout(resolve, ms))

  /**
   * Se resuelve cuando videos e imágenes no diferidas ya pueden pintarse.
   * `onProgress` recibe la fracción de medios ya resueltos (1 si no hay nada
   * pendiente) para alimentar el relleno del logo.
   */
  function mediaReady(onProgress: (progress: number) => void) {
    const pending: Promise<unknown>[] = []

    $$<HTMLVideoElement>('video').forEach((video) => {
      if (video.readyState >= 3) return
      pending.push(
        new Promise<void>((resolve) => {
          const done = () => resolve()
          video.addEventListener('canplay', done, { once: true })
          video.addEventListener('loadeddata', done, { once: true })
          video.addEventListener('error', done, { once: true })
        }),
      )
    })

    $$<HTMLImageElement>('img').forEach((image) => {
      if (image.complete || image.loading === 'lazy') return
      pending.push(
        new Promise<void>((resolve) => {
          image.addEventListener('load', () => resolve(), { once: true })
          image.addEventListener('error', () => resolve(), { once: true })
        }),
      )
    })

    const total = pending.length
    if (!total) {
      onProgress(1)
      return Promise.resolve([])
    }

    let settled = 0
    onProgress(0)

    return Promise.all(
      pending.map((item) =>
        item.then((value) => {
          settled += 1
          onProgress(settled / total)
          return value
        }),
      ),
    )
  }

  /**
   * Rellena el trazo del logo de abajo hacia arriba. El objetivo es monótono:
   * combina el progreso real de los medios con el tiempo transcurrido para que
   * el relleno avance aunque un medio tarde en resolverse.
   */
  function createLogoFill(root: HTMLElement, prefersReducedMotion: boolean) {
    const logo = $<HTMLElement>('[data-loader-logo]', root)
    if (!logo) return null

    const state = { value: 0 }

    const apply = (value: number) => {
      logo.style.setProperty('--logo-fill', String(value))
      logo.style.setProperty('--logo-edge', value > 0.02 && value < 0.985 ? '1' : '0')
    }

    const render = () => apply(state.value)

    if (prefersReducedMotion) {
      state.value = 1
      render()
      return { state, render, setMediaProgress: () => {}, stopTicker: () => {}, kill: () => {} }
    }

    apply(0)

    const startedAt = performance.now()
    let mediaProgress = 0
    let target = 0
    let running = true

    const tick = () => {
      const elapsed = performance.now() - startedAt
      // El reloj marca el ritmo mínimo y los medios pueden frenarlo, pero el
      // avance lento de `creep` evita que el relleno se quede congelado.
      const paced = Math.min(mediaProgress, elapsed / MIN_SPINNER_MS)
      const creep = Math.min(elapsed / MAX_WAIT_MS, 1) * 0.9
      target = Math.min(Math.max(target, paced, creep), 1)
      state.value += (target - state.value) * 0.08
      apply(state.value)
    }

    gsap.ticker.add(tick)

    const stop = () => {
      if (!running) return
      running = false
      gsap.ticker.remove(tick)
    }

    return {
      /** El timeline de salida toma el control del relleno con `stopTicker`. */
      state,
      render,
      setMediaProgress: (progress: number) => {
        mediaProgress = Math.max(mediaProgress, progress)
      },
      stopTicker: stop,
      kill: stop,
    }
  }

  /**
   * Las marcas no giran: aparecen creciendo en secuencia alrededor del aro y
   * luego desaparecen encogiéndose en el mismo orden.
   */
  function createSpinnerLoop(root: HTMLElement, prefersReducedMotion: boolean) {
    const lines = $$<HTMLElement>('[data-loader-tick]', root)
    if (!lines.length) return null

    gsap.set(lines, { scaleY: 0, opacity: 0 })

    if (prefersReducedMotion) {
      gsap.set(lines, { scaleY: 1, opacity: 1 })
      return null
    }

    return gsap
      .timeline({ repeat: -1, repeatDelay: 0.1 })
      .to(lines, {
        scaleY: 1,
        opacity: 1,
        duration: 0.4,
        ease: 'power2.out',
        stagger: { each: 0.014 },
      })
      .to(
        lines,
        {
          scaleY: 0,
          opacity: 0,
          duration: 0.38,
          ease: 'power2.in',
          stagger: { each: 0.014 },
        },
        '>-0.2',
      )
  }

  async function runLoader() {
    const loader = $<HTMLElement>('#site-loader')
    if (!loader) return

    loader.dataset.loaderActive = 'true'
    document.documentElement.classList.add('is-loading')
    getLenis()?.stop()

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const spinner = $<HTMLElement>('[data-loader-spinner]', loader)
    const phrases = $$<HTMLElement>('[data-loader-phrase]', loader)
    const spinnerLoop = createSpinnerLoop(loader, prefersReducedMotion)
    const logoFill = createLogoFill(loader, prefersReducedMotion)

    // La carga real manda, pero el spinner se ve un mínimo y nunca bloquea de más.
    await Promise.race([
      Promise.all([
        mediaReady((progress) => logoFill?.setMediaProgress(progress)),
        wait(MIN_SPINNER_MS),
      ]),
      wait(MAX_WAIT_MS),
    ])

    const finish = () => {
      spinnerLoop?.kill()
      logoFill?.kill()
      loader.remove()
      markDone()
    }

    if (prefersReducedMotion) {
      gsap.to(loader, { autoAlpha: 0, duration: 0.4, onComplete: finish })
      return
    }

    const timeline = gsap.timeline({ onComplete: finish })

    // El logo termina de rellenarse antes de que el spinner ceda el lugar.
    if (logoFill) {
      logoFill.stopTicker()
      timeline.to(
        logoFill.state,
        { value: 1, duration: 0.55, ease: 'power2.out', onUpdate: logoFill.render },
        0,
      )
    }

    // El spinner sale y cede el lugar a las frases.
    timeline.to(
      spinner,
      {
        autoAlpha: 0,
        yPercent: -18,
        duration: 0.45,
        ease: 'power2.inOut',
        onComplete: () => spinnerLoop?.kill(),
      },
      logoFill ? 0.45 : 0,
    )

    phrases.forEach((phrase) => {
      const words = $$<HTMLElement>('[data-loader-word]', phrase)

      timeline
        .set(phrase, { opacity: 1 })
        .fromTo(
          words,
          { yPercent: -130 },
          { yPercent: 0, duration: 0.6, ease: 'power3.out', stagger: 0.05 },
        )
        .to({}, { duration: 0.55 })
        .to(words, { yPercent: 130, duration: 0.45, ease: 'power3.in', stagger: 0.04 })
        .set(phrase, { opacity: 0 })
    })

    // Revelado final del sitio.
    timeline.to(loader, { autoAlpha: 0, duration: 0.5, ease: 'power2.inOut' }, '-=0.2')
  }

  runLoader()

  // Este módulo solo corre en la primera carga: tras una navegación con
  // ClientRouter el markup del loader vuelve al DOM y hay que retirarlo.
  document.addEventListener('astro:page-load', () => {
    const current = $<HTMLElement>('#site-loader')
    // `astro:page-load` también se dispara en la carga inicial: ahí el loader
    // está corriendo y no debe tocarse.
    if (!current || current.dataset.loaderActive === 'true') return
    current.remove()
    markDone()
  })
</script>
