---
import type { ProyectoDocumento, ProyectoFoto } from '@/lib/content'

interface Props {
  /** El detalle del proyecto ya cargó el contenido; se pasa tal cual. */
  fotos: ProyectoFoto[]
  documentos: ProyectoDocumento[]
  projectTitle: string
}

const { fotos, documentos, projectTitle } = Astro.props

/** El visor trabaja con un único formato de diapositiva para ambas galerías. */
const grupos = {
  fotos: fotos.map((foto, index) => ({
    src: foto.src,
    alt: foto.alt,
    titulo: `Fotografía ${String(index + 1).padStart(2, '0')}`,
    descripcion: foto.alt,
    archivo: '',
    contain: false,
  })),
  planos: documentos.map((documento) => ({
    src: documento.preview,
    alt: `Plano ${documento.titulo} del proyecto ${projectTitle}`,
    titulo: documento.titulo,
    descripcion: documento.descripcion,
    archivo: documento.archivo,
    contain: true,
  })),
}
---

<dialog
  class="proyecto-visor m-auto h-full max-h-none w-full max-w-none overflow-hidden bg-transparent p-0 text-white backdrop:bg-[#0f0e0c]/94"
  aria-label={`Galería del proyecto ${projectTitle}`}
  data-proyecto-visor
>
  <div class="proyecto-visor-panel relative flex h-full w-full flex-col">
    <header
      class="flex shrink-0 items-start justify-between gap-6 px-[clamp(1rem,4vw,2.5rem)] pt-[clamp(1rem,3vw,1.75rem)]"
    >
      <div class="flex min-w-0 flex-col gap-1">
        <p class="vmv-caption-1 tracking-[0.22em] text-white/50 uppercase" data-proyecto-visor-kicker>
        </p>
        <h2 class="vmv-title-3 truncate text-white" data-proyecto-visor-title></h2>
      </div>

      <div class="flex shrink-0 items-center gap-3">
        <a
          href="#"
          target="_blank"
          rel="noreferrer"
          class="vmv-caption-1 hidden items-center gap-2 rounded-full border border-white/25 px-4 py-2 tracking-[0.18em] text-white/80 uppercase transition-colors duration-300 hover:border-white hover:text-white"
          data-proyecto-visor-download
        >
          PDF
          <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M8 2.5v9M4 8l4 4 4-4M2.5 13.5h11"
              stroke="currentColor"
              stroke-width="1.3"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>

        <button
          type="button"
          class="inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border border-white/25 text-white transition-colors duration-300 hover:border-white hover:bg-white hover:text-[#0f0e0c] focus-visible:ring-2 focus-visible:ring-white focus-visible:outline-none"
          aria-label="Cerrar galería"
          data-proyecto-visor-close
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M4 4l8 8M12 4l-8 8"
              stroke="currentColor"
              stroke-width="1.3"
              stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
    </header>

    <figure
      class="relative flex min-h-0 flex-1 items-center justify-center px-[clamp(1rem,4vw,2.5rem)] py-[clamp(1rem,3vw,1.75rem)]"
    >
      <img
        class="proyecto-visor-image max-h-full max-w-full object-contain"
        alt=""
        data-proyecto-visor-image
        decoding="async"
      />

      <button
        type="button"
        class="absolute top-1/2 left-[clamp(0.5rem,2vw,1.5rem)] flex h-11 w-11 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border border-white/25 bg-[#0f0e0c]/55 text-white backdrop-blur-sm transition-colors duration-300 hover:bg-white hover:text-[#0f0e0c] disabled:pointer-events-none disabled:opacity-25"
        aria-label="Anterior"
        data-proyecto-visor-prev
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M10 3.5L5 8l5 4.5"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
      <button
        type="button"
        class="absolute top-1/2 right-[clamp(0.5rem,2vw,1.5rem)] flex h-11 w-11 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border border-white/25 bg-[#0f0e0c]/55 text-white backdrop-blur-sm transition-colors duration-300 hover:bg-white hover:text-[#0f0e0c] disabled:pointer-events-none disabled:opacity-25"
        aria-label="Siguiente"
        data-proyecto-visor-next
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M6 3.5l5 4.5-5 4.5"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
    </figure>

    <footer
      class="flex shrink-0 flex-col gap-3 px-[clamp(1rem,4vw,2.5rem)] pb-[clamp(1rem,3vw,1.75rem)]"
    >
      <div class="flex items-end justify-between gap-6">
        <p class="vmv-body-3 max-w-[60ch] text-white/60" data-proyecto-visor-description></p>
        <p
          class="vmv-caption-1 shrink-0 tracking-[0.18em] text-white/60 tabular-nums"
          data-proyecto-visor-counter
        >
        </p>
      </div>

      <div
        class="flex gap-2 overflow-x-auto scrollbar-none [&::-webkit-scrollbar]:hidden"
        data-proyecto-visor-thumbs
        role="tablist"
        aria-label="Miniaturas"
      >
      </div>
    </footer>
  </div>
</dialog>

<script
  is:inline
  type="application/json"
  data-proyecto-visor-data
  set:html={JSON.stringify(grupos)}
/>

<script>
  import { $, $$ } from '@/lib/dom-selector'

  interface Slide {
    src: string
    alt: string
    titulo: string
    descripcion: string
    archivo: string
    contain: boolean
  }

  type Grupos = Record<string, Slide[]>

  const KICKERS: Record<string, string> = {
    fotos: 'Galería',
    planos: 'Documentos técnicos',
  }

  const CLOSE_DURATION = 320

  let cleanupVisor: (() => void) | null = null

  const setupProyectoVisor = () => {
    cleanupVisor?.()
    cleanupVisor = null

    const modal = $<HTMLDialogElement>('[data-proyecto-visor]')
    const dataScript = $<HTMLScriptElement>('[data-proyecto-visor-data]')
    if (!modal || !dataScript) {
      return
    }

    let grupos: Grupos = {}
    try {
      grupos = JSON.parse(dataScript.textContent ?? '{}') as Grupos
    } catch {
      return
    }

    const image = $<HTMLImageElement>('[data-proyecto-visor-image]', modal)
    const kickerEl = $<HTMLElement>('[data-proyecto-visor-kicker]', modal)
    const titleEl = $<HTMLElement>('[data-proyecto-visor-title]', modal)
    const descriptionEl = $<HTMLElement>('[data-proyecto-visor-description]', modal)
    const counterEl = $<HTMLElement>('[data-proyecto-visor-counter]', modal)
    const downloadEl = $<HTMLAnchorElement>('[data-proyecto-visor-download]', modal)
    const thumbsEl = $<HTMLElement>('[data-proyecto-visor-thumbs]', modal)
    const prevButton = $<HTMLButtonElement>('[data-proyecto-visor-prev]', modal)
    const nextButton = $<HTMLButtonElement>('[data-proyecto-visor-next]', modal)

    if (!image || !thumbsEl) {
      return
    }

    const controller = new AbortController()
    const { signal } = controller

    let closeTimer: number | undefined
    let previousBodyPaddingRight = ''
    let lastFocused: HTMLElement | null = null
    let slides: Slide[] = []
    let index = 0

    const lockScroll = () => {
      const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth
      previousBodyPaddingRight = document.body.style.paddingRight
      document.body.style.overflow = 'hidden'
      if (scrollbarWidth > 0) {
        document.body.style.paddingRight = `${scrollbarWidth}px`
      }
      window.lenis?.stop()
    }

    const unlockScroll = () => {
      document.body.style.overflow = ''
      document.body.style.paddingRight = previousBodyPaddingRight
      window.lenis?.start()
    }

    const prefersReducedMotion = () =>
      window.matchMedia('(prefers-reduced-motion: reduce)').matches

    // La tira de miniaturas se desborda cuando hay muchas imágenes; se centra
    // la activa para que las siguientes vayan apareciendo al navegar.
    const scrollThumbIntoView = (thumb: HTMLElement, instant = false) => {
      const maxScroll = thumbsEl.scrollWidth - thumbsEl.clientWidth
      if (maxScroll <= 0) {
        return
      }
      const target = Math.min(
        Math.max(thumb.offsetLeft - (thumbsEl.clientWidth - thumb.offsetWidth) / 2, 0),
        maxScroll,
      )
      thumbsEl.scrollTo({
        left: target,
        behavior: instant || prefersReducedMotion() ? 'auto' : 'smooth',
      })
    }

    const showSlide = (nextIndex: number, instantThumbScroll = false) => {
      if (slides.length === 0) {
        return
      }
      index = (nextIndex + slides.length) % slides.length
      const slide = slides[index]

      image.src = slide.src
      image.alt = slide.alt
      // Los planos se leen mejor sobre un lienzo claro; las fotos van a sangre.
      image.classList.toggle('proyecto-visor-image--plano', slide.contain)

      if (titleEl) {
        titleEl.textContent = slide.titulo
      }
      if (descriptionEl) {
        descriptionEl.textContent = slide.descripcion
      }
      if (counterEl) {
        counterEl.textContent = `${String(index + 1).padStart(2, '0')} / ${String(
          slides.length,
        ).padStart(2, '0')}`
      }
      if (downloadEl) {
        downloadEl.href = slide.archivo || '#'
        downloadEl.classList.toggle('hidden', !slide.archivo)
        downloadEl.classList.toggle('inline-flex', Boolean(slide.archivo))
      }

      $$<HTMLButtonElement>('[data-proyecto-visor-thumb]', thumbsEl).forEach((thumb, i) => {
        const isActive = i === index
        thumb.setAttribute('aria-selected', String(isActive))
        thumb.dataset.active = isActive ? 'true' : 'false'
        if (isActive) {
          scrollThumbIntoView(thumb, instantThumbScroll)
        }
      })

      const hasMultiple = slides.length > 1
      if (prevButton) {
        prevButton.disabled = !hasMultiple
      }
      if (nextButton) {
        nextButton.disabled = !hasMultiple
      }
    }

    const renderThumbs = () => {
      thumbsEl.textContent = ''
      if (slides.length < 2) {
        thumbsEl.hidden = true
        return
      }
      thumbsEl.hidden = false
      slides.forEach((slide, i) => {
        const thumb = document.createElement('button')
        thumb.type = 'button'
        thumb.setAttribute('role', 'tab')
        thumb.dataset.proyectoVisorThumb = ''
        thumb.className =
          'relative h-14 w-20 shrink-0 cursor-pointer overflow-hidden rounded-xs opacity-45 ring-1 ring-white/20 transition-[opacity,box-shadow] duration-300 hover:opacity-100 data-[active=true]:opacity-100 data-[active=true]:ring-white'
        thumb.setAttribute('aria-label', `Ver imagen ${i + 1}`)

        const thumbImage = document.createElement('img')
        thumbImage.src = slide.src
        thumbImage.alt = ''
        thumbImage.loading = 'lazy'
        thumbImage.decoding = 'async'
        thumbImage.className = slide.contain
          ? 'h-full w-full bg-white object-contain'
          : 'h-full w-full object-cover'

        thumb.append(thumbImage)
        thumb.addEventListener('click', () => showSlide(i), { signal })
        thumbsEl.append(thumb)
      })
    }

    const openVisor = (grupo: string, startIndex: number, trigger?: HTMLElement) => {
      const nextSlides = grupos[grupo]
      if (!nextSlides || nextSlides.length === 0 || modal.open) {
        return
      }

      slides = nextSlides
      if (kickerEl) {
        kickerEl.textContent = KICKERS[grupo] ?? ''
      }
      renderThumbs()
      thumbsEl.scrollLeft = 0
      showSlide(startIndex, true)

      window.clearTimeout(closeTimer)
      lastFocused = trigger ?? (document.activeElement as HTMLElement | null)
      modal.classList.remove('is-closing')
      modal.showModal()
      lockScroll()
      requestAnimationFrame(() => {
        modal.classList.add('is-open')
      })
    }

    const closeVisor = () => {
      if (!modal.open) {
        return
      }

      modal.classList.remove('is-open')
      modal.classList.add('is-closing')

      closeTimer = window.setTimeout(() => {
        modal.classList.remove('is-closing')
        modal.close()
        unlockScroll()
        lastFocused?.focus()
      }, CLOSE_DURATION)
    }

    prevButton?.addEventListener('click', () => showSlide(index - 1), { signal })
    nextButton?.addEventListener('click', () => showSlide(index + 1), { signal })

    $$<HTMLElement>('[data-proyecto-visor-close]', modal).forEach((button) => {
      button.addEventListener('click', closeVisor, { signal })
    })

    // Los disparadores viven en la página; se delega el clic para no tener que
    // registrarlos uno por uno según cuántas fotos o planos traiga el proyecto.
    document.addEventListener(
      'click',
      (event) => {
        const target = event.target as HTMLElement | null
        const trigger = target?.closest<HTMLElement>('[data-visor-trigger]')
        if (!trigger) {
          return
        }
        event.preventDefault()
        openVisor(
          trigger.dataset.visorGrupo ?? 'fotos',
          Number(trigger.dataset.visorIndice ?? '0'),
          trigger,
        )
      },
      { signal },
    )

    // `cancel` (Esc) cerraría de golpe; se intercepta para animar la salida.
    modal.addEventListener(
      'cancel',
      (event) => {
        event.preventDefault()
        closeVisor()
      },
      { signal },
    )

    modal.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'ArrowLeft') {
          event.preventDefault()
          showSlide(index - 1)
        } else if (event.key === 'ArrowRight') {
          event.preventDefault()
          showSlide(index + 1)
        }
      },
      { signal },
    )

    cleanupVisor = () => {
      window.clearTimeout(closeTimer)
      controller.abort()
      if (modal.open) {
        modal.close()
        unlockScroll()
      }
    }
  }

  document.addEventListener('astro:before-swap', () => {
    cleanupVisor?.()
    cleanupVisor = null
  })

  document.addEventListener('astro:page-load', setupProyectoVisor)
  setupProyectoVisor()
</script>

<style>
  .proyecto-visor::backdrop {
    opacity: 0;
    transition: opacity 0.32s ease;
  }

  .proyecto-visor.is-open::backdrop {
    opacity: 1;
  }

  .proyecto-visor-panel {
    opacity: 0;
    transform: scale(0.98);
    transition:
      opacity 0.32s ease,
      transform 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .proyecto-visor.is-open .proyecto-visor-panel {
    opacity: 1;
    transform: scale(1);
  }

  .proyecto-visor-image--plano {
    background: #fff;
    padding: clamp(0.75rem, 2vw, 1.75rem);
  }

  @media (prefers-reduced-motion: reduce) {
    .proyecto-visor::backdrop,
    .proyecto-visor-panel {
      transition: none;
    }
  }
</style>
