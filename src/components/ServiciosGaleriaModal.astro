---
import { getServicios, type Servicio } from '@/lib/content'

interface Props {
  /** La sección ya cargó los servicios; se pasan para no consultar dos veces. */
  servicios?: Servicio[]
}

const { servicios = await getServicios() } = Astro.props

const galerias = servicios.map((servicio) => ({
  id: servicio.id,
  title: servicio.title,
  footer: servicio.footer,
  description: servicio.description,
  gallery: servicio.gallery,
}))
---

<dialog
  class="servicios-galeria m-auto w-[min(72rem,calc(100vw-2rem))] max-w-none overflow-visible bg-transparent p-0 text-vmv-foreground backdrop:bg-black/80"
  aria-labelledby="servicios-galeria-title"
  data-servicios-galeria
>
  <div
    class="servicios-galeria-panel relative flex max-h-[calc(100svh-4rem)] flex-col gap-5 overflow-y-auto border border-vmv-border bg-vmv-background px-[clamp(1rem,3vw,2.25rem)] py-[clamp(1.5rem,4vw,2.5rem)]"
  >
    <button
      type="button"
      class="absolute top-4 right-4 z-10 inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border border-vmv-border bg-vmv-background text-vmv-foreground transition-colors duration-300 hover:bg-vmv-muted focus-visible:ring-2 focus-visible:ring-vmv-ring focus-visible:outline-none"
      aria-label="Cerrar galería del servicio"
      data-servicios-galeria-close
    >
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"
        ></path>
      </svg>
    </button>

    <header class="flex flex-col gap-3 pr-12">
      <p class="vmv-overline-1 flex items-center gap-3 text-vmv-sand-9">
        <span class="h-px w-9 bg-vmv-sand-9/60" aria-hidden="true"></span>
        <span data-servicios-galeria-footer>Servicios</span>
      </p>
      <h2 id="servicios-galeria-title" class="vmv-title-2 text-vmv-foreground">
        <span data-servicios-galeria-title></span>
      </h2>
      <p
        class="vmv-body-3 max-w-[52ch] text-vmv-muted-foreground"
        data-servicios-galeria-description
      >
      </p>
    </header>

    <figure class="relative overflow-hidden rounded-sm bg-vmv-muted">
      <img
        class="servicios-galeria-image aspect-16/10 w-full object-cover"
        alt=""
        data-servicios-galeria-image
        decoding="async"
      />
      <div
        class="pointer-events-none absolute inset-0 rounded-sm ring-1 ring-vmv-sand-1/12 ring-inset"
        aria-hidden="true"
      >
      </div>

      <button
        type="button"
        class="absolute top-1/2 left-3 flex h-10 w-10 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border border-vmv-sand-1/25 bg-vmv-gray-12/45 text-vmv-sand-1 backdrop-blur-sm transition-colors duration-300 hover:bg-vmv-gray-12/70 disabled:pointer-events-none disabled:opacity-30"
        aria-label="Foto anterior"
        data-servicios-galeria-prev
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M10 3.5L5 8l5 4.5"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
      <button
        type="button"
        class="absolute top-1/2 right-3 flex h-10 w-10 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border border-vmv-sand-1/25 bg-vmv-gray-12/45 text-vmv-sand-1 backdrop-blur-sm transition-colors duration-300 hover:bg-vmv-gray-12/70 disabled:pointer-events-none disabled:opacity-30"
        aria-label="Foto siguiente"
        data-servicios-galeria-next
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M6 3.5l5 4.5-5 4.5"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>

      <figcaption
        class="vmv-caption-1 absolute right-3 bottom-3 rounded-full bg-vmv-gray-12/55 px-3 py-1 tracking-[0.18em] text-vmv-sand-1 tabular-nums backdrop-blur-sm"
        data-servicios-galeria-counter
      >
      </figcaption>
    </figure>

    <div
      class="flex gap-3 overflow-x-auto scrollbar-none pb-1 [&::-webkit-scrollbar]:hidden"
      data-servicios-galeria-thumbs
      role="tablist"
      aria-label="Fotos del servicio"
    >
    </div>
  </div>
</dialog>

<script
  is:inline
  type="application/json"
  data-servicios-galeria-data
  set:html={JSON.stringify(galerias)}
/>

<script>
  import { $, $$ } from '@/lib/dom-selector'

  interface ServicioFoto {
    src: string
    alt: string
  }

  interface ServicioGaleria {
    id: string
    title: string
    footer: string
    description: string
    gallery: ServicioFoto[]
  }

  const CLOSE_DURATION = 320

  let cleanupGaleria: (() => void) | null = null

  const setupServiciosGaleria = () => {
    cleanupGaleria?.()
    cleanupGaleria = null

    const modal = $<HTMLDialogElement>('[data-servicios-galeria]')
    const dataScript = $<HTMLScriptElement>('[data-servicios-galeria-data]')
    if (!modal || !dataScript) {
      return
    }

    let galerias: ServicioGaleria[] = []
    try {
      galerias = JSON.parse(dataScript.textContent ?? '[]') as ServicioGaleria[]
    } catch {
      return
    }

    const image = $<HTMLImageElement>('[data-servicios-galeria-image]', modal)
    const titleEl = $<HTMLElement>('[data-servicios-galeria-title]', modal)
    const footerEl = $<HTMLElement>('[data-servicios-galeria-footer]', modal)
    const descriptionEl = $<HTMLElement>('[data-servicios-galeria-description]', modal)
    const counterEl = $<HTMLElement>('[data-servicios-galeria-counter]', modal)
    const thumbsEl = $<HTMLElement>('[data-servicios-galeria-thumbs]', modal)
    const prevButton = $<HTMLButtonElement>('[data-servicios-galeria-prev]', modal)
    const nextButton = $<HTMLButtonElement>('[data-servicios-galeria-next]', modal)

    if (!image || !thumbsEl) {
      return
    }

    const controller = new AbortController()
    const { signal } = controller

    let closeTimer: number | undefined
    let previousBodyPaddingRight = ''
    let lastFocused: HTMLElement | null = null
    let fotos: ServicioFoto[] = []
    let index = 0

    const lockScroll = () => {
      const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth
      previousBodyPaddingRight = document.body.style.paddingRight
      document.body.style.overflow = 'hidden'
      if (scrollbarWidth > 0) {
        document.body.style.paddingRight = `${scrollbarWidth}px`
      }
      window.lenis?.stop()
    }

    const unlockScroll = () => {
      document.body.style.overflow = ''
      document.body.style.paddingRight = previousBodyPaddingRight
      window.lenis?.start()
    }

    const showFoto = (nextIndex: number) => {
      if (fotos.length === 0) {
        return
      }
      index = (nextIndex + fotos.length) % fotos.length
      const foto = fotos[index]
      image.src = foto.src
      image.alt = foto.alt
      if (counterEl) {
        counterEl.textContent = `${String(index + 1).padStart(2, '0')} / ${String(
          fotos.length,
        ).padStart(2, '0')}`
      }
      $$<HTMLButtonElement>('[data-servicios-galeria-thumb]', thumbsEl).forEach((thumb, i) => {
        thumb.setAttribute('aria-selected', String(i === index))
        thumb.dataset.active = i === index ? 'true' : 'false'
      })
      const hasMultiple = fotos.length > 1
      if (prevButton) {
        prevButton.disabled = !hasMultiple
      }
      if (nextButton) {
        nextButton.disabled = !hasMultiple
      }
    }

    const renderThumbs = () => {
      thumbsEl.textContent = ''
      if (fotos.length < 2) {
        thumbsEl.hidden = true
        return
      }
      thumbsEl.hidden = false
      fotos.forEach((foto, i) => {
        const thumb = document.createElement('button')
        thumb.type = 'button'
        thumb.setAttribute('role', 'tab')
        thumb.dataset.serviciosGaleriaThumb = ''
        thumb.className =
          'relative h-16 w-24 shrink-0 cursor-pointer overflow-hidden rounded-sm opacity-55 ring-1 ring-vmv-border transition-[opacity,box-shadow] duration-300 hover:opacity-100 data-[active=true]:opacity-100 data-[active=true]:ring-vmv-foreground'
        thumb.setAttribute('aria-label', `Ver foto ${i + 1}`)

        const thumbImage = document.createElement('img')
        thumbImage.src = foto.src
        thumbImage.alt = ''
        thumbImage.loading = 'lazy'
        thumbImage.decoding = 'async'
        thumbImage.className = 'h-full w-full object-cover'

        thumb.append(thumbImage)
        thumb.addEventListener('click', () => showFoto(i), { signal })
        thumbsEl.append(thumb)
      })
    }

    const openGaleria = (servicioId: string, trigger?: HTMLElement) => {
      const servicio = galerias.find((item) => item.id === servicioId)
      if (!servicio || servicio.gallery.length === 0 || modal.open) {
        return
      }

      fotos = servicio.gallery
      if (titleEl) {
        titleEl.textContent = servicio.title
      }
      if (footerEl) {
        footerEl.textContent = servicio.footer
      }
      if (descriptionEl) {
        descriptionEl.textContent = servicio.description
      }
      renderThumbs()
      showFoto(0)

      window.clearTimeout(closeTimer)
      lastFocused = trigger ?? (document.activeElement as HTMLElement | null)
      modal.classList.remove('is-closing')
      modal.showModal()
      lockScroll()
      requestAnimationFrame(() => {
        modal.classList.add('is-open')
      })
    }

    const closeGaleria = () => {
      if (!modal.open) {
        return
      }

      modal.classList.remove('is-open')
      modal.classList.add('is-closing')

      closeTimer = window.setTimeout(() => {
        modal.classList.remove('is-closing')
        modal.close()
        unlockScroll()
        lastFocused?.focus()
      }, CLOSE_DURATION)
    }

    prevButton?.addEventListener('click', () => showFoto(index - 1), { signal })
    nextButton?.addEventListener('click', () => showFoto(index + 1), { signal })

    $$<HTMLElement>('[data-servicios-galeria-close]', modal).forEach((button) => {
      button.addEventListener('click', closeGaleria, { signal })
    })

    // El `dialog` solo ocupa el área del panel, así que un clic cuyo target
    // sea el propio dialog corresponde al backdrop.
    modal.addEventListener(
      'click',
      (event) => {
        if (event.target === modal) {
          closeGaleria()
        }
      },
      { signal },
    )

    // `cancel` (Esc) cerraría de golpe; se intercepta para animar la salida.
    modal.addEventListener(
      'cancel',
      (event) => {
        event.preventDefault()
        closeGaleria()
      },
      { signal },
    )

    modal.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'ArrowLeft') {
          event.preventDefault()
          showFoto(index - 1)
        } else if (event.key === 'ArrowRight') {
          event.preventDefault()
          showFoto(index + 1)
        }
      },
      { signal },
    )

    document.addEventListener(
      'servicios:open-galeria',
      (event) => {
        const detail = (event as CustomEvent<{ id: string; trigger?: HTMLElement }>).detail
        if (detail?.id) {
          openGaleria(detail.id, detail.trigger)
        }
      },
      { signal },
    )

    cleanupGaleria = () => {
      window.clearTimeout(closeTimer)
      controller.abort()
      if (modal.open) {
        modal.close()
        unlockScroll()
      }
    }
  }

  document.addEventListener('astro:before-swap', () => {
    cleanupGaleria?.()
    cleanupGaleria = null
  })

  document.addEventListener('astro:page-load', setupServiciosGaleria)
  setupServiciosGaleria()
</script>

<style>
  .servicios-galeria::backdrop {
    opacity: 0;
    transition: opacity 0.32s ease;
  }

  .servicios-galeria.is-open::backdrop {
    opacity: 1;
  }

  .servicios-galeria-panel {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.32s ease,
      transform 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .servicios-galeria.is-open .servicios-galeria-panel {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .servicios-galeria::backdrop,
    .servicios-galeria-panel {
      transition: none;
    }
  }
</style>
