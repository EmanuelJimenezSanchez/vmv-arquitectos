---
/**
 * Pixel de Meta para el sitio público. Sin `PUBLIC_META_PIXEL_ID` el pixel no
 * se carga: así el entorno local no ensucia las métricas del anuncio.
 */
const pixelId = import.meta.env.PUBLIC_META_PIXEL_ID ?? ''
---

<script is:inline define:vars={{ pixelId }}>
  // Código base oficial de Meta. Sin ID no se carga nada; con el ClientRouter
  // este script puede volver a evaluarse al navegar y el guard evita
  // inicializar dos veces.
  if (pixelId && !window.fbq) {
    !(function (f, b, e, v, n, t, s) {
      if (f.fbq) return
      n = f.fbq = function () {
        n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments)
      }
      if (!f._fbq) f._fbq = n
      n.push = n
      n.loaded = !0
      n.version = '2.0'
      n.queue = []
      t = b.createElement(e)
      t.async = !0
      t.src = v
      s = b.getElementsByTagName(e)[0]
      s.parentNode.insertBefore(t, s)
    })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js')
    window.fbq('init', pixelId)
  }
</script>

<script>
  import { $ } from '@/lib/dom-selector'
  import { trackMeta } from '@/lib/meta-pixel'

  /**
   * `astro:page-load` dispara en la carga inicial y en cada navegación del
   * ClientRouter, así que hay exactamente un PageView por página vista (el
   * código base de Meta lo mandaría solo en la primera).
   */
  document.addEventListener('astro:page-load', () => {
    trackMeta('PageView')

    // Las fichas de proyecto se marcan con `data-meta-view-content`.
    const content = $<HTMLElement>('[data-meta-view-content]')
    if (content) {
      trackMeta('ViewContent', {
        content_type: 'product',
        content_ids: content.dataset.contentId ?? '',
        content_name: content.dataset.contentName ?? '',
        content_category: content.dataset.contentCategory ?? '',
      })
    }
  })

  /**
   * Clics a WhatsApp, correo o teléfono: el contacto sale del sitio, así que
   * es la única oportunidad de medirlo. Delegado en `document` para cubrir
   * cualquier enlace presente o futuro sin re-enlazar en cada navegación.
   */
  document.addEventListener('click', (event) => {
    const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('a[href]')
    if (!link) {
      return
    }

    const href = link.getAttribute('href') ?? ''
    const method = href.startsWith('mailto:')
      ? 'email'
      : href.startsWith('tel:')
        ? 'phone'
        : /^https:\/\/(wa\.me|api\.whatsapp\.com)\//.test(href)
          ? 'whatsapp'
          : null

    if (method) {
      trackMeta('Contact', { contact_method: method })
    }
  })
</script>
