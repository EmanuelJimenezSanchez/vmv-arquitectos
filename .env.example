# --- Cloudflare R2 -----------------------------------------------------------
# URL pública del bucket (dominio r2.dev o dominio propio), sin slash final.
R2_BUCKET_URL=https://pub-xxxxxxxxxxxx.r2.dev
# Credenciales de la API S3 de R2 (Cloudflare Dashboard > R2 > Manage API tokens).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=vmv-arquitectos

# --- Supabase ----------------------------------------------------------------
# Settings > API. Las PUBLIC_ se exponen al navegador (es correcto: son públicas).
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
# Solo para scripts de seed/administración. NUNCA se importa desde el sitio.
SUPABASE_SERVICE_ROLE_KEY=

# --- Correo (formulario de contacto) -----------------------------------------
# Proveedor. Si se omite: mailtrap en dev, resend en build de producción.
EMAIL_PROVIDER=mailtrap
# Remitente. En Resend el dominio tiene que estar verificado.
EMAIL_FROM=VMV Arquitectos <web@vmvarquitectos.com>
# Destinatarios de los avisos, separados por comas.
EMAIL_TO=victor.medina@vmvarquitectos.com, v.galicia@vmvarquitectos.com

# Mailtrap (pruebas): Email Testing > Inbox > Integrations > API.
MAILTRAP_TOKEN=
MAILTRAP_INBOX_ID=

# Resend (producción): https://resend.com/api-keys
RESEND_API_KEY=
